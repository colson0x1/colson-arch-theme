pkgbase = colson-arch-theme
	pkgdesc = Omarchy-grade theming for GNOME on Arch — 143 themes incl. the original Colson pack, wallpapers forged from any palette, live across GNOME Shell, GTK, icons, cursor, terminals, tmux, Neovim, btop, browser and editors
	pkgver = 1.3.1
	pkgrel = 1
	url = https://github.com/colson0x1/colson-arch-theme
	arch = any
	license = MIT
	depends = python>=3.11
	depends = git
	depends = gnome-shell
	depends = glib2
	optdepends = fzf: interactive picker (theme pick)
	optdepends = alacritty: terminal palette
	optdepends = kitty: terminal palette
	optdepends = foot: terminal palette
	optdepends = tmux: status line theme (opt-in)
	optdepends = chromium: browser frame color
	optdepends = ghostty: terminal palette integration
	optdepends = neovim: colorscheme hook
	optdepends = btop: btop theme sync
	optdepends = librsvg: theme forge renders wallpapers to 4K PNG
	optdepends = uv: installs the GNOME extension set via gext
	optdepends = papirus-icon-theme: icon theme fallback
	optdepends = yaru-icon-theme: per-theme icon variants
	optdepends = adw-gtk-theme: GTK3 apps follow the theme
	optdepends = bibata-cursor-theme: cursor theme
	source = colson-arch-theme-1.3.1.tar.gz::https://github.com/colson0x1/colson-arch-theme/archive/v1.3.1.tar.gz
	sha256sums = ce147b917a889e6fbb4ab2ae3dcbdacc72c9b96e920bb28eac3a4d2387f92dee

pkgname = colson-arch-theme
