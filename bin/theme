.quick-slider .slider, .slider { -barlevel-active-background-color: @ACC@; -barlevel-background-color: @FG16@; -slider-handle-border-color: @BORDER@; }

/* calendar and clock menu */
.calendar .calendar-day-base:hover, .calendar .calendar-day-base:focus { background-color: @ACC18@; }
.calendar .calendar-today, .calendar .calendar-today:hover, .calendar .calendar-today:focus, .calendar .calendar-today:selected { background-color: @ACC@; color: @ACC_FG@; }
.calendar .calendar-day-with-events { color: @ACC@; }
