.dash-background, #dash { background-color: @DASH@; border: 1px solid @BORDER@; border-radius: 22px; }
.app-well-app-running-dot, .dash .app-well-app-running-dot { background-color: @ACC@; }
.app-well-app:hover .overview-icon, .app-well-app:focus .overview-icon, .app-well-app:selected .overview-icon, .show-apps:hover .overview-icon, .show-apps:checked .overview-icon, .app-folder:hover .overview-icon { background-color: @ACC20@; }
