def nearest_name(hexcol, table):
    """Nearest named color. Colorfulness is judged by RGB chroma (max-min), not HLS saturation, which
    inflates for near-black values; hue then dominates for colorful inputs, lightness for greys."""
    def parts(hx):
        r, g, b = (x / 255 for x in _rgb(hx))
        h, l, _ = colorsys.rgb_to_hls(r, g, b)
        return h, l, max(r, g, b) - min(r, g, b)
    h, l, ch = parts(hexcol)
    colorful = ch > 0.18

    def dist(other):
        h2, l2, ch2 = parts(other)
        if colorful != (ch2 > 0.18):
            return 9.0                     # colorful accents stay among colorful variants, greys among greys
        if colorful:
            dh = min(abs(h - h2), 1 - abs(h - h2)) * 3.0
            return dh * dh + (l - l2) ** 2 * 0.15          # hue decides; lightness only breaks ties
        return (l - l2) ** 2 * 0.6 + (ch - ch2) ** 2 * 0.4  # greys: lightness decides
    return min(table, key=lambda n: dist(table[n]))


def installed_icon_themes():
    names = set()
    for base in ICON_DIRS:
        if base.exists():
            names |= {d.name for d in base.iterdir() if (d / "index.theme").exists()}
    return names


def installed_gtk_themes():
    names = set()
    for base in THEME_DIRS:
        if base.exists():
            names |= {d.name for d in base.iterdir() if d.is_dir()}
    return names


def papirus_overlay(c):
    """A user-level icon theme that inherits Papirus (Dark or Light by mode) and swaps every folder icon for the
    variant nearest the accent — Papirus ships all the colors; only symlinks and an index are created."""
    import configparser
    root = next((b for b in ICON_DIRS if (b / "Papirus" / "index.theme").exists()), None)
    if not root:
        return None
    color = nearest_name(c["acc"], PAPIRUS_FOLDERS)
    papirus = root / "Papirus"
    name = f"{APP}-papirus-{color}" + ("" if c["light"] else "-dark")
    dest = XDG_DATA / "icons" / name
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    try:
        cp.read(papirus / "index.theme", encoding="utf-8")
    except configparser.Error:
        return None
    dirs = [d.strip() for d in cp.get("Icon Theme", "Directories", fallback="").split(",") if d.strip()]
    if dest.exists():
        shutil.rmtree(dest, ignore_errors=True)
    sections, made = [], 0
    for d in dirs:
        if not cp.has_section(d) or cp.get(d, "Context", fallback="") != "Places":
            continue
        srcdir = papirus / d
        if not srcdir.is_dir():
            continue
        colored = sorted(srcdir.glob(f"folder-{color}*.svg"))
        if not colored:
            continue
        (dest / d).mkdir(parents=True, exist_ok=True)
        for f in colored:
            (dest / d / f.name.replace(f"folder-{color}", "folder", 1)).symlink_to(f.resolve())
            made += 1
        sections.append(d)
    if not made:
        shutil.rmtree(dest, ignore_errors=True)
        return None
    inherits = "Papirus,breeze,hicolor" if c["light"] else "Papirus-Dark,Papirus,breeze-dark,hicolor"
    idx = ["[Icon Theme]", f"Name={name}", f"Comment=Papirus with {color} folders, generated by {APP}",
           f"Inherits={inherits}", f"Directories={','.join(sections)}", ""]
    for d in sections:
        idx.append(f"[{d}]")
        idx += [f"{k}={cp.get(d, k)}" for k in ("Size", "Context", "Type", "MinSize", "MaxSize", "Scale") if cp.has_option(d, k)]
        idx.append("")
    (dest / "index.theme").write_text("\n".join(idx))
    if shutil.which("gtk-update-icon-cache"):
        subprocess.run(["gtk-update-icon-cache", "-f", "-t", "-q", str(dest)], capture_output=True)
    for old in (XDG_DATA / "icons").glob(f"{APP}-papirus-*"):
        if old != dest:
            shutil.rmtree(old, ignore_errors=True)
    return name


def icons_clear():
    for old in (XDG_DATA / "icons").glob(f"{APP}-papirus-*"):
        shutil.rmtree(old, ignore_errors=True)


def icons_apply(dirp, lines, decl_acc, mode):
    """Declared Yaru variant (else the one nearest the accent), -dark on dark themes; else Papirus with
    accent-colored folders; else leave the icon theme alone."""
    have = installed_icon_themes()
    c = scheme_from(lines, decl_acc, mode)
    want = ""
    f = dirp / "icons.theme" if dirp else None
    if f and f.exists():
        first = (f.read_text(errors="ignore").strip().splitlines() or [""])[0].strip()
        want = first if re.fullmatch(r"[A-Za-z0-9._-]{1,40}", first) else ""
    base = re.sub(r"-(dark|light)$", "", want)
    if any(n.startswith("Yaru") for n in have):
        pool = {k: v for k, v in YARU_VARIANTS.items() if k in have} or YARU_VARIANTS
        yaru = base if base in have else nearest_name(c["acc"], pool)
        for cand in ([f"{yaru}-dark"] if not c["light"] else []) + [yaru] + (["Yaru-dark"] if not c["light"] else ["Yaru"]):
            if cand in have:
                gset("org.gnome.desktop.interface", "icon-theme", cand)
                return cand
    if "Papirus" in have:
        name = papirus_overlay(c)
        if not name:
            name = "Papirus" if c["light"] else ("Papirus-Dark" if "Papirus-Dark" in have else "Papirus")
        gset("org.gnome.desktop.interface", "icon-theme", name)
        return name
    return None


def cursor_apply(light):
    have = installed_icon_themes()
    for cand in (("Bibata-Modern-Classic", "Bibata-Modern-Ice") if light else ("Bibata-Modern-Ice", "Bibata-Modern-Classic")):
        if cand in have:
            gset("org.gnome.desktop.interface", "cursor-theme", cand)
            return cand
    return None


def gtk3_theme_apply(light):
    want = "adw-gtk3" if light else "adw-gtk3-dark"
    if want in installed_gtk_themes():
        gset("org.gnome.desktop.interface", "gtk-theme", want)
        return want
    return None


def extension_states():
    """uuid → ACTIVE | INACTIVE | OUT OF DATE | ERROR | not loaded (GNOME only learns new dirs at login)"""
    out = {}
    for uuid, _ in EXTENSIONS:
        r = subprocess.run(["gnome-extensions", "info", uuid], capture_output=True, text=True)
        m = re.search(r"^\s*State:\s*(.+)$", r.stdout, re.M)
        out[uuid] = m.group(1).strip() if (r.returncode == 0 and m) else ("not loaded" if (EXT_DIR / uuid).exists() else "missing")
    return out


