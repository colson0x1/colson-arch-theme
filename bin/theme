.list-search-result:hover, .list-search-result:focus, .list-search-result:selected, .grid-search-result:focus .overview-icon, .grid-search-result:selected .overview-icon { background-color: @ACC20@; }
.window-caption { background-color: @POPUP@; color: @FG@; border: 1px solid @BORDER@; }
