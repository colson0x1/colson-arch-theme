def shell_css(name, lines, decl_acc, mode):
    c = scheme_from(lines, decl_acc, mode)
    tokens = {"@NAME@": name, "@APP@": APP, "@CREDIT@": CREDIT, "@FG@": c["fg"], "@ACC@": c["acc"], "@ACC_FG@": c["acc_fg"],
              "@SURFACE2@": c["surface2"], "@BORDER@": c["border"], "@PANEL@": _rgba(c["bg"], 0.72),
              "@POPUP@": _rgba(c["surface"], 0.92), "@DASH@": _rgba(c["bg"], 0.62), "@SHIELD@": _rgba(c["bg"], 0.55),
              "@ACC18@": _rgba(c["acc"], 0.18), "@ACC20@": _rgba(c["acc"], 0.20), "@ACC22@": _rgba(c["acc"], 0.22),
              "@ACC24@": _rgba(c["acc"], 0.24), "@ACC28@": _rgba(c["acc"], 0.28), "@FG08@": _rgba(c["fg"], 0.08),
              "@FG10@": _rgba(c["fg"], 0.10), "@FG16@": _rgba(c["fg"], 0.16), "@FG30@": _rgba(c["fg"], 0.30),
              "@FG45@": _rgba(c["fg"], 0.45)}
    css = SHELL_CSS
    for k, v in tokens.items():
        css = css.replace(k, v)
    return css


def shell_apply(name, lines, decl_acc, mode):
    """Generate a GNOME Shell theme (imports the stock stylesheet, overrides colors) and select it through User Themes.
    The selection is written even before the extension is loaded, so it takes effect the moment it is."""
    d = SHELL_THEMES / f"theme-{name}" / "gnome-shell"
    d.mkdir(parents=True, exist_ok=True)
    (d / "gnome-shell.css").write_text(shell_css(name, lines, decl_acc, mode))
    sd = EXT_DIR / USER_THEME_UUID / "schemas"
    if sd.exists():
        gset("org.gnome.shell.extensions.user-theme", "name", f"theme-{name}", schemadir=sd)
    return True


def gtk_generate(name, lines, decl_acc, mode):
    """libadwaita named colors from the palette → GTK4 + GTK3 apps recolor (when a theme ships no gtk.css)."""
    c = scheme_from(lines, decl_acc, mode)
    shade = "rgba(0,0,0,0.36)" if not c["light"] else "rgba(0,0,0,0.07)"
    view = _mix(c["bg"], "#000000", 0.25) if not c["light"] else "#ffffff"
    css = f"""/* theme: {name} — libadwaita colors generated by {APP} ({CREDIT}) — {MANAGED} */
@define-color accent_bg_color {c['acc']}; @define-color accent_fg_color {c['acc_fg']}; @define-color accent_color {c['acc']};
@define-color destructive_bg_color {c['red']}; @define-color destructive_fg_color #ffffff; @define-color destructive_color {c['red']};
@define-color success_color {c['green']}; @define-color warning_color {c['yellow']}; @define-color error_color {c['red']};
@define-color window_bg_color {c['bg']}; @define-color window_fg_color {c['fg']};
@define-color view_bg_color {view}; @define-color view_fg_color {c['fg']};
@define-color headerbar_bg_color {c['surface']}; @define-color headerbar_fg_color {c['fg']}; @define-color headerbar_border_color {c['border']};
@define-color headerbar_backdrop_color {c['bg']}; @define-color headerbar_shade_color {shade}; @define-color headerbar_darker_shade_color {shade};
@define-color card_bg_color {_rgba(c['fg'], 0.07)}; @define-color card_fg_color {c['fg']}; @define-color card_shade_color {shade};
@define-color dialog_bg_color {c['surface']}; @define-color dialog_fg_color {c['fg']};
@define-color popover_bg_color {c['surface']}; @define-color popover_fg_color {c['fg']}; @define-color popover_shade_color {shade};
@define-color sidebar_bg_color {c['surface']}; @define-color sidebar_fg_color {c['fg']}; @define-color sidebar_backdrop_color {c['bg']}; @define-color sidebar_shade_color {shade}; @define-color sidebar_border_color {c['border']};
@define-color secondary_sidebar_bg_color {c['bg']}; @define-color secondary_sidebar_fg_color {c['fg']}; @define-color secondary_sidebar_backdrop_color {c['bg']}; @define-color secondary_sidebar_shade_color {shade}; @define-color secondary_sidebar_border_color {c['border']};
@define-color thumbnail_bg_color {c['surface']}; @define-color thumbnail_fg_color {c['fg']};
@define-color shade_color {shade}; @define-color scrollbar_outline_color rgba(0,0,0,0.5);
"""
    for t in (GTK4, GTK3):
        t.parent.mkdir(parents=True, exist_ok=True)
        t.write_text(css)
    return True


def gtk_apply(dirp):
    src = dirp / "gtk.css"
    if not src.exists():
        return False
    for t in (GTK4, GTK3):
        t.parent.mkdir(parents=True, exist_ok=True)
        t.write_text(f"/* theme: {dirp.name} — {MANAGED}; removed on `theme graphite` / `theme uninstall` */\n"
                     + src.read_text(errors="ignore"))
    return True


def gtk_clear():
    for t in (GTK4, GTK3):
        if t.exists() and MANAGED in t.read_text(errors="ignore")[:160]:
            t.unlink()


def btop_apply(name, dirp):
    b = dirp / "btop.theme"
    if not b.exists() or not shutil.which("btop"):
        return False
    td = BTOP_DIR / "themes"
    td.mkdir(parents=True, exist_ok=True)
    shutil.copy(b, td / f"{name}.theme")
    conf = BTOP_DIR / "btop.conf"
    txt = conf.read_text() if conf.exists() else ""
    if re.search(r"^color_theme\s*=", txt, re.M):
        txt = re.sub(r"^color_theme\s*=.*$", f'color_theme = "{name}"', txt, flags=re.M)
    else:
        txt += f'\ncolor_theme = "{name}"\n'
    conf.write_text(txt)
    return True


# ─────────────────────────────── wallpaper ───────────────────────────────────
def set_wall(path):
    uri = f"file://{path}"
    for k in ("picture-uri", "picture-uri-dark"):
        gset("org.gnome.desktop.background", k, uri)
    gset("org.gnome.desktop.background", "picture-options", "zoom")
    gset("org.gnome.desktop.screensaver", "picture-uri", uri)


def rel(p):
    try:
        return str(p.relative_to(THEMES))
    except ValueError:
        return str(p)


# ─────────────────────────────── apply ───────────────────────────────────────
def write_ghostty(lines, header):
    GHOSTTY_ACTIVE.parent.mkdir(parents=True, exist_ok=True)
    GHOSTTY_ACTIVE.write_text(f"# {header}\n" + "\n".join(lines) + ("\n" if lines else ""))


def report(title, subtitle, rows):
    print(f" {B(title)}   {D(subtitle)}")
    for k, v in rows:
        print(f"   {D(k.ljust(10))} {v}")
    credit()


def apply(name, wall="first", quiet=False):
    """Everything a switch touches, gated by `theme targets`, then the live pass so nothing needs a reload."""
    migrate()
    T = targets_state()
    graphite = name == "graphite"
    if graphite:
        d, lines, decl_acc, light, sch = None, [], "#ffffff", False, None
    else:
        d = themes().get(name)
        if not d:
            sys.exit(f"unknown theme: {name}   (theme list · theme sync)")
        lines, decl_acc, mode = terminal_colors(d)
        light = (mode == "light") or (d / "light.mode").exists()
        sch = nvim_scheme(d)
    m = "light" if light else "dark"
    gen = lines or GRAPHITE_LINES          # the palette every generated surface is derived from
    r = {}

    # desktop
    if T["wallpaper"] and not graphite:
        bgs = backgrounds(d)
        if bgs:
            set_wall(random.choice(bgs) if wall == "random" else bgs[0])
        r["wallpaper"] = "set" if bgs else "none"
    if T["accent"]:
        acc = "slate" if graphite else (hue_to_accent(decl_acc) if decl_acc else accent_from(lines))
        if acc:
            gset("org.gnome.desktop.interface", "accent-color", acc)
        gset("org.gnome.desktop.interface", "color-scheme", "default" if light else "prefer-dark")
        pb = full_palette(gen)["bg"]
        gset("org.gnome.desktop.background", "primary-color", pb)
        gset("org.gnome.desktop.screensaver", "primary-color", pb)
        r["accent"] = acc or "-"
    if T["shell"]:
        r["shell"] = "generated" if shell_apply(name, gen, decl_acc, m) else "-"
    if T["gtk"]:
        shipped = (not graphite) and (d / "gtk.css").exists()
        if graphite:
            gtk_clear()
        (gtk_apply(d) if shipped else gtk_generate(name, gen, decl_acc, m))
        g3 = gtk3_theme_apply(light)
        r["gtk"] = ("shipped" if shipped else "generated") + (f" · {g3}" if g3 else "")
    if T["icons"]:
        r["icons"] = icons_apply(d, gen, decl_acc, m) or "-"
    if T["cursor"]:
        r["cursor"] = cursor_apply(light) or "-"

    # terminals
    if T["ghostty"]:
        write_ghostty(lines, f"theme: {name}" if lines else "graphite — base Ghostty config rules (true-black monochrome)")
        r["ghostty"] = f"{len(lines)} keys" if lines else "base config"
    for key, cfg, active, frag in (("alacritty", ALACRITTY_CONFIG, ALACRITTY_ACTIVE, alacritty_fragment),
                                   ("kitty", KITTY_CONFIG, KITTY_ACTIVE, kitty_fragment),
                                   ("foot", FOOT_CONFIG, FOOT_ACTIVE, foot_fragment)):
        if T[key] and cfg.exists():
            active.parent.mkdir(parents=True, exist_ok=True)
            active.write_text(frag(name, lines))
            r[key] = "yes"
    if T["tmux"] and tmux_config():
        TMUX_ACTIVE.parent.mkdir(parents=True, exist_ok=True)
        TMUX_ACTIVE.write_text(tmux_fragment(name, lines, decl_acc, m))
        r["tmux"] = "yes"

    # editors, browser
    if T["nvim"]:
        nvim_hook_write(name, sch, gen, m)
        r["nvim"] = sch or "canvas"
    if T["btop"] and not graphite:
        r["btop"] = "yes" if btop_apply(name, d) else "-"
    if T["vscode"]:
        if graphite:
            eds = editors_restore()
            r["vscode"] = ("restored: " + ", ".join(eds)) if eds else "-"
        else:
            vn, ve = vscode_decl(d)
            eds = editors_apply(vn, ve) if vn else []
            r["vscode"] = f"{vn} → {', '.join(eds)}" if eds else (f"{vn} (extension not installed)" if vn else "-")
    if T["browser"]:
        br = browsers_apply(browser_rgb(d, gen))
        r["browser"] = ", ".join(br) if br else "-"
    (STATE / "active").write_text(name + "\n")

    # live
    if T["live"]:
        tl = terminals_live(lines)
        nl = nvim_live() if T["nvim"] else 0
        tm = tmux_live() if (T["tmux"] and "tmux" in r) else False
        r["live"] = f"{tl} terminal{'s' if tl != 1 else ''} · {nl} neovim" + (" · tmux" if tm else "")

    if quiet:
        return
    off = [n for n, _, _ in TARGETS if not T[n]]
    line = lambda keys: " · ".join(f"{k} {r[k]}" for k in keys if k in r) or "-"
    rows = [("desktop", line(("wallpaper", "shell", "gtk", "icons", "cursor"))),
            ("terminals", line(("ghostty", "alacritty", "kitty", "foot", "tmux"))),
            ("editors", line(("nvim", "btop", "vscode"))),
            ("browser", r.get("browser", "-")),
            ("live", r.get("live", "off"))]
    if off:
        rows.append(("targets off", ", ".join(off)))
    sub = "true-black OS · wallpaper unchanged" if graphite else f"{m} · accent {r.get('accent', '-')}"
    if lines and T["ghostty"]:
        sub += "   (open windows recolored; ctrl+shift+, makes new Ghostty windows match)"
    report(name, sub, rows)


# ─────────────────────────────── browse ──────────────────────────────────────
def swatch(lines, n=8):
    pal, meta = palette_of(lines)
    order = [meta.get("background")] + [pal.get(i) for i in (1, 2, 3, 4, 5, 6)] + [meta.get("foreground")]
    return "".join(bg(c) for c in order[:n])


def cmd_status():
    ts = themes()
    act = active_name()
    wall = gget("org.gnome.desktop.background", "picture-uri-dark")
    wall = wall.split("/themes/", 1)[-1] if "/themes/" in wall else wall.rsplit("/", 1)[-1]
    tmr = subprocess.run(["systemctl", "--user", "is-active", "wallpaper-rotate.timer"], capture_output=True, text=True).stdout.strip()
    nxt = subprocess.run(["systemctl", "--user", "list-timers", "wallpaper-rotate.timer", "--no-pager"], capture_output=True, text=True).stdout.splitlines()
    nxt = " ".join(nxt[1].split()[:3]) if len(nxt) > 1 and nxt[1].strip() else "-"
    d = ts.get(act)
    l = terminal_colors(d)[0] if d else GRAPHITE_LINES
    sched = STATE / "schedule"
    print()
    print(f" {B('THEME')}      {B(act)}  {swatch(l)}")
    print(f" {B('WALLPAPER')}  {wall or '-'}")
    print(f" {B('ROTATION')}   {tmr or 'off'} {D('· next')} {nxt}")
    if sched.exists():
        print(f" {B('SCHEDULE')}   {' · '.join(sched.read_text().split())}")
    print(f" {B('LIBRARY')}    {len(ts)} themes {D('·')} {sum(len(backgrounds(x)) for x in ts.values())} wallpapers")
    print(f" {D('theme pick · theme random · theme <name> · theme graphite · theme wall random · theme help')}")
    credit()
    print()


def cmd_list(plain=False, as_json=False):
    ts = themes()
    off = [n for n, p in ts.items() if is_official(p)]
    com = [n for n in ts if n not in off]
    if as_json:
        out = []
        for n, d in ts.items():
            l, acc, mode = terminal_colors(d)
            pal, meta = palette_of(l)
            out.append(dict(name=n, official=n in off, wallpapers=len(backgrounds(d)), mode=mode or "dark",
                            accent=acc, background=meta.get("background"), foreground=meta.get("foreground"),
                            palette=[pal.get(i) for i in range(16)], nvim=nvim_scheme(d)))
        print(json.dumps(dict(active=active_name(), themes=out), indent=2))
        return
    if plain:
        print("official:", ", ".join(off))
        print("community:", ", ".join(com))
        return
    act = active_name()
    walls = sum(len(backgrounds(d)) for d in ts.values())
    print()
    print(f" {B('THEME SYSTEM')}   {D('active')} {B(act)}   {D('·')} {len(ts)} themes {D('·')} {walls} wallpapers   {D('·  ' + CREDIT)}")
    for title, names in (("OFFICIAL", off), ("COMMUNITY", com)):
        print()
        print(f" {B(title)} {D('(' + str(len(names)) + ')')}")
        for n in names:
            d = ts[n]
            l, acc, mode = terminal_colors(d)
            w = len(backgrounds(d))
            sch = nvim_scheme(d) or "-"
            mark = "▸" if n == act else " "
            wtxt = f"{w:>2}w"
            mtxt = f"{(mode or 'dark'):<5}"
            print(f" {mark} {n:<22} {swatch(l)}  {D(wtxt)}  {D(mtxt)}  {D(sch[:22])}")
    print()


def cmd_preview(name):
    if name == "graphite":
        print()
        print(f" {B('graphite')}  {D('base · true-black monochrome · the whole OS in black and white')}")
        pal, meta = palette_of(GRAPHITE_LINES)
        for row in (range(0, 8), range(8, 16)):
            print("   " + "".join(bg(pal.get(i), "    ") for i in row))
        print()
        credit()
        return
    d = themes().get(name)
    if not d:
        sys.exit(f"unknown theme: {name}")
    l, acc, mode = terminal_colors(d)
    pal, meta = palette_of(l)
    bgc, fgc = meta.get("background"), meta.get("foreground")
    src = "official" if is_official(d) else "community"
    print()
    print(f" {B(name)}  {D(src)}  {D('·')} {D(mode or 'dark')}  {D('·')} accent {bg(acc or pal.get(4))} {D(acc or pal.get(4) or '-')}")
    print(f" {D('bg')} {bg(bgc, '    ')} {D(bgc or '-')}   {D('fg')} {bg(fgc, '    ')} {D(fgc or '-')}   "
          f"{D('cursor')} {bg(meta.get('cursor-color'), '    ')} {D(meta.get('cursor-color') or '-')}")
    for row in (range(0, 8), range(8, 16)):
        print("   " + "".join(bg(pal.get(i), "    ") for i in row) + "   "
              + D(" ".join((pal.get(i) or "  -   ")[1:] for i in row)))
    if COLOR and bgc and fgc:
        r, g, b = _rgb(bgc)
        fr, fg_, fb = _rgb(fgc)
        line = "The quick brown fox jumps over the lazy dog  0123456789  ~/syrosin/typemuse  git:(dev)"
        print(f"\n   \x1b[48;2;{r};{g};{b}m\x1b[38;2;{fr};{fg_};{fb}m  {line}  \x1b[0m")
    bgs = backgrounds(d)
    print(f"\n   {D('wallpapers')} {len(bgs)}  " + D(", ".join(f.name for f in bgs[:6]) + (" …" if len(bgs) > 6 else "")))
    print(f"   {D('nvim')} {nvim_scheme(d) or '-'}   {D('btop')} {'yes' if (d / 'btop.theme').exists() else '-'}   "
          f"{D('gtk.css')} {'shipped' if (d / 'gtk.css').exists() else 'generated'}")
    print()
    credit()


def cmd_pick():
    if not shutil.which("fzf"):
        sys.exit("fzf not installed →  sudo pacman -S fzf   (then `theme pick` gives you a live-preview browser)")
    names = ["graphite"] + list(themes().keys())
    fz = subprocess.run(["fzf", "--ansi", "--prompt", "theme ▸ ", "--height", "90%", "--layout", "reverse",
                         "--border", "rounded", "--preview", f"FORCE_COLOR=1 {SCRIPT} preview {{}}",
                         "--preview-window", "right,62%,wrap", "--header",
                         f"enter = apply everything · esc = cancel · {CREDIT}", "--color", "bw"],
                        input="\n".join(names), capture_output=True, text=True)
    sel = fz.stdout.strip()
    if sel:
        apply(sel, "first")


def cmd_show(name):
    d = themes().get(name)
    if not d:
        sys.exit(f"unknown theme: {name}")
    for f in ("preview.png", "preview.jpg", "preview-unlock.png"):
        if (d / f).exists():
            subprocess.Popen(["xdg-open", str(d / f)])
            return
    bgs = backgrounds(d)
    if bgs:
        subprocess.Popen(["xdg-open", str(bgs[0])])
        return
    sys.exit("no preview image in this theme")


def cmd_wall(arg):
    if arg == "random":
        pool = [f for d in themes().values() for f in backgrounds(d)]
    else:
        d = themes().get(arg)
        pool = backgrounds(d) if d else []
    if not pool:
        sys.exit("no wallpapers found (theme sync?)")
    p = random.choice(pool)
    set_wall(p)
    print(f"wallpaper: {rel(p)}")


def cmd_next_wall():
    act = active_name()
    d = themes().get(act)
    pool = backgrounds(d) if d else [f for dd in themes().values() for f in backgrounds(dd)]
    if pool:
        p = random.choice(pool)
        set_wall(p)
        print(f"wallpaper: {rel(p)}")


# ─────────────────────────────── library ─────────────────────────────────────
def manifest_paths():
    cands = [SCRIPT.parent.parent / "manifest" / "themes.txt",
             pathlib.Path("/usr/share") / APP / "manifest" / "themes.txt",
             DATA / "manifest.txt"]
    return [p for p in cands if p.exists()]


def manifest_entries():
    seen, out = set(), []
    for mp in manifest_paths() + [STATE / "manifest.local.txt"]:
        if not mp.exists():
            continue
        for line in mp.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            if len(parts) >= 2 and parts[0] not in seen:
                seen.add(parts[0])
                out.append((parts[0], parts[1]))
    return out


def clone(url, dest):
    if dest.exists():
        return "present"
    if DRY:
        print(f"  [dry-run] git clone {url}")
        return "dry-run"
    r = subprocess.run(["git", "clone", "--depth", "1", "--quiet", url, str(dest)],
                       env={**os.environ, "GIT_TERMINAL_PROMPT": "0"}, capture_output=True)
    return "ok" if r.returncode == 0 else "failed"


def cmd_sync(official_only=False, jobs=8):
    migrate()
    THEMES.mkdir(parents=True, exist_ok=True)
    print(f" {B('sync')} {D('official bundle')} … ", end="", flush=True)
    print(clone(OFFICIAL_URL, THEMES / "_omarchy"))
    if official_only:
        credit()
        return
    entries = manifest_entries()
    print(f" {B('sync')} {D(str(len(entries)) + ' community themes, ' + str(jobs) + ' parallel')}")
    results = {}
    with ThreadPoolExecutor(max_workers=jobs) as ex:
        for name, res in zip([n for n, _ in entries], ex.map(lambda e: clone(e[1], THEMES / e[0]), entries)):
            results[name] = res
    ok = sum(1 for v in results.values() if v in ("ok", "present", "dry-run"))
    failed = [n for n, v in results.items() if v == "failed"]
    print(f" {B('done')} {ok}/{len(entries)} available" + (f" · unavailable: {', '.join(failed)}" if failed else ""))
    credit()


def cmd_add(url, name=None):
    if not url.startswith("https://"):
        sys.exit("usage: theme add https://github.com/<user>/<repo> [name]")
    base = url.rstrip("/").split("/")[-1].removesuffix(".git")
    name = name or re.sub(r"^omarchy-|-theme$|-omarchy$", "", base) or base
    dest = THEMES / name
    if dest.exists():
        sys.exit(f"already installed: {name}")
    if clone(url, dest) != "ok":
        sys.exit("clone failed")
    STATE.mkdir(parents=True, exist_ok=True)
    with (STATE / "manifest.local.txt").open("a") as f:
        f.write(f"{name} {url}\n")
    l, acc, mode = terminal_colors(dest)
    print(f"installed {B(name)} · colors {len(l)} · wallpapers {len(backgrounds(dest))}  →  theme preview {name}")
    credit()


def cmd_update():
    ok = fail = 0
    for d in sorted(THEMES.iterdir()) if THEMES.exists() else []:
        if (d / ".git").exists():
            r = subprocess.run(["git", "-C", str(d), "pull", "--quiet", "--ff-only"], capture_output=True)
            ok += (r.returncode == 0)
            fail += (r.returncode != 0)
    print(f"updated {ok} repos" + (f" · {fail} failed" if fail else ""))
    credit()


def cmd_remove(name):
    d = THEMES / name
    if not d.exists() or name.startswith("_"):
        sys.exit(f"not a removable community theme: {name}")
    shutil.rmtree(d)
    print(f"removed {name}")


def cmd_credits():
    print()
    print(f" {B('CREDITS')}   {D('this tool stands on the work of every theme author below')}")
    print(f" {rule()}")
    print(f"   {B('Omarchy')}  {D('DHH / Omacom Foundation — the theme format and the official bundle')}  {D('https://omarchy.org')}")
    print(f"   {B(APP)}  {D(CREDIT)}  {D(REPO_URL)}")
    print()
    print(f" {B('COMMUNITY THEMES')}")
    for name, url in manifest_entries():
        m = re.match(r"https://github\.com/([^/]+)/", url)
        author = m.group(1) if m else "-"
        print(f"   {name:<24} {D('@' + author):<22} {D(url)}")
    print()
    credit()


# ─────────────────────────────── install / uninstall ─────────────────────────
GHOSTTY_INCLUDE = "config-file = ?themes/active.conf"
NVIM_HOOK_LINE = 'pcall(dofile, vim.fn.expand("~/.config/colson-arch-theme/active-nvim.lua"))'
OLD_NVIM_HOOK = 'pcall(dofile, vim.fn.expand("~/.config/omarchy-themes/active-nvim.lua"))'


def hook_ghostty():
    if not GHOSTTY_CONFIG.exists():
        return "ghostty: no config found — skipped"
    s = GHOSTTY_CONFIG.read_text()
    if GHOSTTY_INCLUDE in s:
        return "ghostty: include already wired"
    s = s.rstrip() + f"\n\n# ── {APP}: active theme palette (empty file = your base config) ──\n{GHOSTTY_INCLUDE}\n"
    GHOSTTY_CONFIG.write_text(s)
    GHOSTTY_ACTIVE.parent.mkdir(parents=True, exist_ok=True)
    if not GHOSTTY_ACTIVE.exists():
        GHOSTTY_ACTIVE.write_text("# graphite — base Ghostty config rules\n")
    return "ghostty: include wired"


def hook_nvim():
    if not NVIM_INIT.exists():
        return "nvim: no init.lua found — skipped"
    s = NVIM_INIT.read_text()
    if OLD_NVIM_HOOK in s:
        s = s.replace(OLD_NVIM_HOOK, NVIM_HOOK_LINE)
        NVIM_INIT.write_text(s)
        return "nvim: hook migrated to new path"
    if NVIM_HOOK_LINE in s:
        return "nvim: hook already wired"
    s = s.rstrip() + f"\n\n-- {APP} hook: `theme <name>` rewrites this file; it applies at VimEnter and aligns the editor canvas to the terminal\n{NVIM_HOOK_LINE}\n"
    NVIM_INIT.write_text(s)
    nvim_hook_write("graphite", None, GRAPHITE_LINES, "dark")
    return "nvim: hook wired"


def unit_write(name, service, timer):
    SYSTEMD_USER.mkdir(parents=True, exist_ok=True)
    (SYSTEMD_USER / f"{name}.service").write_text(service)
    if timer:
        (SYSTEMD_USER / f"{name}.timer").write_text(timer)
    userctl("daemon-reload")


def rotation_units(minutes):
    unit_write("wallpaper-rotate",
               f"[Unit]\nDescription={APP}: rotate GNOME wallpaper within the active theme\n[Service]\nType=oneshot\nExecStart={SCRIPT} next-wall\n",
               f"[Unit]\nDescription={APP}: wallpaper rotation every {minutes} minutes\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec={minutes}min\n[Install]\nWantedBy=timers.target\n")
    userctl("enable", "--now", "wallpaper-rotate.timer")


def gext_bin():
    for c in (shutil.which("gext"), HOME / ".local/bin/gext"):
        if c and pathlib.Path(c).exists():
            return str(c)
    return None


def ensure_gext():
    if gext_bin():
        return gext_bin()
    for tool in (("uv", ["uv", "tool", "install", "gnome-extensions-cli"]),
                 ("pipx", ["pipx", "install", "gnome-extensions-cli"])):
        if shutil.which(tool[0]):
            subprocess.run(tool[1], capture_output=True)
            if gext_bin():
                return gext_bin()
    return None


def configure_desktop():
    """macOS-grade dock, glass blur, boot-to-desktop, window buttons. Idempotent."""
    def s(schemadir, schema, key, val):
        gset(schema, key, val, schemadir=schemadir)
    dd = EXT_DIR / "dash-to-dock@micxgx.gmail.com" / "schemas"
    S = "org.gnome.shell.extensions.dash-to-dock"
    if dd.exists():
        for k, v in (("dock-position", "'BOTTOM'"), ("dash-max-icon-size", "48"), ("dock-fixed", "false"),
                     ("intellihide", "true"), ("autohide", "true"), ("extend-height", "false"),
                     ("transparency-mode", "'DYNAMIC'"), ("background-opacity", "0.35"),
                     ("running-indicator-style", "'DOTS'"), ("show-apps-at-top", "false"), ("show-trash", "false"),
                     ("show-mounts", "false"), ("click-action", "'minimize-or-previews'"),
                     ("scroll-action", "'cycle-windows'"), ("multi-monitor", "true"), ("custom-theme-shrink", "true"),
                     ("disable-overview-on-startup", "true")):
            s(dd, S, k, v)
    bm = EXT_DIR / "blur-my-shell@aunetx" / "schemas"
    SB = "org.gnome.shell.extensions.blur-my-shell"
    if bm.exists():
        for sch, k, v in ((SB + ".panel", "blur", "true"), (SB + ".panel", "override-background", "true"),
                          (SB + ".panel", "static-blur", "true"), (SB + ".overview", "blur", "true"),
                          (SB + ".dash-to-dock", "blur", "true"), (SB + ".applications", "blur", "false"),
                          (SB, "sigma", "30"), (SB, "brightness", "0.6")):
            s(bm, sch, k, v)
    jp = EXT_DIR / "just-perfection-desktop@just-perfection" / "schemas"
    if jp.exists():
        for k, v in (("startup-status", "0"), ("animation", "4"), ("theme", "false")):
            s(jp, "org.gnome.shell.extensions.just-perfection", k, v)
    gset("org.gnome.desktop.wm.preferences", "button-layout", "appmenu:minimize,maximize,close")
    gset("org.gnome.mutter", "center-new-windows", "true")
    gset("org.gnome.desktop.interface", "clock-show-weekday", "true")


def cmd_install(no_sync=False, no_extensions=False, minutes=30):
    migrate()
    print()
    print(f" {B('install')} {D(APP + ' v' + VERSION)}")
    print(f" {rule()}")
    if not no_sync:
        cmd_sync()
    for status in (hook_ghostty(), hook_nvim(), hook_alacritty(), hook_kitty(), hook_foot(), hook_tmux()):
        print(f"   {status}")
    rotation_units(minutes)
    print(f"   timer: wallpaper rotation every {minutes} min")
    new_ext = 0
    if not no_extensions and DRY:
        print(f"  [dry-run] would install {len(EXTENSIONS)} GNOME extensions and configure the desktop")
    elif not no_extensions:
        gx = ensure_gext()
        if not gx:
            print("   extensions: gext unavailable (install uv or pipx) — skipped; rerun later")
        else:
            for uuid, desc in EXTENSIONS:
                if (EXT_DIR / uuid).exists():
                    continue
                subprocess.run([gx, "-F", "install", uuid], capture_output=True)
                new_ext += (EXT_DIR / uuid).exists()
            enabled = gget("org.gnome.shell", "enabled-extensions")
            want = [u for u, _ in EXTENSIONS if (EXT_DIR / u).exists() or u in enabled]
            cur = re.findall(r"'([^']+)'", enabled)
            merged = list(dict.fromkeys(cur + want))
            gset("org.gnome.shell", "enabled-extensions", "[" + ", ".join(f"'{u}'" for u in merged) + "]")
            configure_desktop()
            active, pending, stale, unlocked = activate_extensions()
            print(f"   extensions: {sum(1 for u, _ in EXTENSIONS if (EXT_DIR / u).exists())}/{len(EXTENSIONS)} present"
                  + (f" · {new_ext} newly installed" if new_ext else "") + f" · {len(active)} active now"
                  + (f" · {len(pending)} after login" if pending else "") + (f" · {len(stale)} out of date" if stale else "")
                  + " · desktop configured")
            new_ext = len(pending)
    if active_name() == "graphite":
        apply("graphite", quiet=True)
    print(f" {rule()}")
    print(f"   {B('next')}  theme pick   {D('·')}  theme icons {D('(icon + cursor packages)')}   {D('·')}  theme targets"
          + (f"   {D('·')}  {B('log out and back in once')} {D('so GNOME loads the new extensions')}" if new_ext else ""))
    credit()
    print()


def cmd_uninstall(purge=False):
    if GHOSTTY_CONFIG.exists():
        s = GHOSTTY_CONFIG.read_text()
        s = "\n".join(l for l in s.splitlines() if GHOSTTY_INCLUDE not in l and f"── {APP}" not in l)
        GHOSTTY_CONFIG.write_text(s.rstrip() + "\n")
    if NVIM_INIT.exists():
        s = NVIM_INIT.read_text()
        s = "\n".join(l for l in s.splitlines() if NVIM_HOOK_LINE not in l and OLD_NVIM_HOOK not in l and f"-- {APP} hook" not in l)
        NVIM_INIT.write_text(s.rstrip() + "\n")
    unhook_alacritty()
    _unwire(KITTY_CONFIG, KITTY_INCLUDE)
    _unwire(FOOT_CONFIG, FOOT_INCLUDE)
    for conf in TMUX_CONFIGS:
        _unwire(conf, TMUX_SOURCE)
    for f in (KITTY_ACTIVE, FOOT_ACTIVE, TMUX_ACTIVE):
        f.unlink(missing_ok=True)
    editors_restore()
    gtk_clear()
    icons_clear()
    for key in ("gtk-theme", "icon-theme", "cursor-theme"):
        greset("org.gnome.desktop.interface", key)
    greset("org.gnome.desktop.background", "primary-color")
    greset("org.gnome.desktop.screensaver", "primary-color")
    sd = EXT_DIR / USER_THEME_UUID / "schemas"
    if sd.exists():
        gset("org.gnome.shell.extensions.user-theme", "name", "", schemadir=sd)
    for u in ("wallpaper-rotate.timer", "theme-schedule.timer"):
        userctl("disable", "--now", u)
    for f in ("wallpaper-rotate.service", "wallpaper-rotate.timer", "theme-schedule.service", "theme-schedule.timer"):
        (SYSTEMD_USER / f).unlink(missing_ok=True)
    userctl("daemon-reload")
    if purge:
        shutil.rmtree(DATA, ignore_errors=True)
        shutil.rmtree(STATE, ignore_errors=True)
        for d in SHELL_THEMES.glob("theme-*"):
            shutil.rmtree(d, ignore_errors=True)
    print("uninstalled: hooks (ghostty, nvim, alacritty, kitty, foot, tmux), timers, GTK overrides, icon overlays, editor themes restored, gtk/icon/cursor settings reset"
          + (" · library and state purged" if purge else " · library kept (theme uninstall --purge)"))


def activate_extensions():
    """Enable every present extension the running shell already knows. GNOME only discovers new extension
    folders at login, so the rest are reported as pending rather than pretended."""
    states = extension_states()
    active, pending, stale = [], [], []
    unlocked = False
    if gget("org.gnome.shell", "disable-user-extensions") == "true":
        # The global kill switch beats every per-extension setting: with it on, nothing user-installed ever runs.
        gset("org.gnome.shell", "disable-user-extensions", "false")
        unlocked = True
    for uuid, _ in EXTENSIONS:
        st = states.get(uuid, "missing")
        if st == "missing":
            continue
        if st == "not loaded":
            pending.append(uuid)
        elif st.upper().startswith("OUT OF DATE"):
            stale.append(uuid)
        else:
            if st.upper() != "ACTIVE" and not DRY:
                subprocess.run(["gnome-extensions", "enable", uuid], capture_output=True)
            active.append(uuid)
    return active, pending, stale, unlocked


def cmd_activate():
    active, pending, stale, unlocked = activate_extensions()
    sd = EXT_DIR / USER_THEME_UUID / "schemas"
    if sd.exists():
        gset("org.gnome.shell.extensions.user-theme", "name", f"theme-{active_name()}", schemadir=sd)
    short = lambda us: ", ".join(u.split("@")[0] for u in us)
    print()
    print(f" {B('activate')}   {D('the GNOME desktop layer')}")
    print(f" {rule()}")
    if unlocked:
        print(f"   {D('unlocked'.ljust(12))} user extensions were switched off globally (disable-user-extensions) — switched on")
    print(f"   {D('active now'.ljust(12))} {len(active)}" + (f"  {D(short(active))}" if active else ""))
    if pending:
        print(f"   {D('after login'.ljust(12))} {len(pending)}  {D(short(pending))}")
        print(f"   {'':<12} {B('log out and back in once')} {D('— GNOME only discovers new extension folders at login')}")
    if stale:
        print(f"   {D('out of date'.ljust(12))} {short(stale)}  {D('waiting for the author to support this GNOME release')}")
    if not pending and not stale:
        print(f"   {D('everything the desktop layer needs is loaded; shell theme:')} theme-{active_name()}")
    print()
    credit()


# ─────────────────────────────── doctor / icons / schedule / io ──────────────
def distro():
    try:
        kv = dict(l.split("=", 1) for l in pathlib.Path("/etc/os-release").read_text().splitlines() if "=" in l)
        return kv.get("PRETTY_NAME", "").strip('"'), (kv.get("ID", "") + " " + kv.get("ID_LIKE", "")).strip('"').lower()
    except Exception:
        return "unknown", ""


def pkg_manager():
    for pm in ("paru", "yay", "pacman", "apt", "dnf", "zypper"):
        if shutil.which(pm):
            return pm
    return None


def cmd_icons():
    pm = pkg_manager()
    pretty, ids = distro()
    if pm in ("paru", "yay"):
        line = f"{pm} -S papirus-icon-theme yaru-icon-theme adw-gtk-theme bibata-cursor-theme"
    elif pm == "pacman":
        line = "sudo pacman -S papirus-icon-theme yaru-icon-theme adw-gtk-theme   # + bibata-cursor-theme from the AUR"
    elif pm == "apt":
        line = "sudo apt install papirus-icon-theme yaru-theme-icon adw-gtk3   # bibata: https://github.com/ful1e5/Bibata_Cursor"
    elif pm == "dnf":
        line = "sudo dnf install papirus-icon-theme yaru-icon-theme adw-gtk3-theme bibata-cursor-themes"
    else:
        line = "install: Papirus icons · Yaru icons · adw-gtk3 · Bibata cursors (your distro's packages)"
    print()
    print(f" {B('icons & cursor')}  {D(pretty)}")
    print(f"   {line}")
    print(f"   gsettings set org.gnome.desktop.interface cursor-theme 'Bibata-Modern-Classic'")
    print(f"   {D('then `theme <name>` picks matching Yaru variants automatically; graphite uses Papirus-Dark')}")
    print()
    credit()


def cmd_doctor(verbose=False, as_json=False):
    migrate()
    pretty, ids = distro()
    shell = subprocess.run(["gnome-shell", "--version"], capture_output=True, text=True).stdout.strip() or "not found"
    ts = themes()
    env = dict(app=f"{APP} {VERSION}", distro=pretty, arch_family=("arch" in ids), gnome=shell,
               session=os.environ.get("XDG_SESSION_TYPE", "?"), python=sys.version.split()[0],
               git=bool(shutil.which("git")), fzf=bool(shutil.which("fzf")), ghostty=GHOSTTY_CONFIG.exists(),
               nvim=NVIM_INIT.exists(), btop=bool(shutil.which("btop")), gext=bool(gext_bin()),
               ghostty_hook=GHOSTTY_CONFIG.exists() and GHOSTTY_INCLUDE in GHOSTTY_CONFIG.read_text(),
               nvim_hook=NVIM_INIT.exists() and NVIM_HOOK_LINE in NVIM_INIT.read_text(),
               rotation=subprocess.run(["systemctl", "--user", "is-active", "wallpaper-rotate.timer"], capture_output=True, text=True).stdout.strip(),
               extensions=extension_states(),
               user_extensions_disabled=gget("org.gnome.shell", "disable-user-extensions") == "true",
               targets=targets_state(),
               terminals=dict(ghostty=GHOSTTY_CONFIG.exists(), alacritty=ALACRITTY_CONFIG.exists(), kitty=KITTY_CONFIG.exists(),
                              foot=FOOT_CONFIG.exists(), tmux=bool(tmux_config())),
               hooks=dict(alacritty=ALACRITTY_CONFIG.exists() and ALACRITTY_IMPORT in ALACRITTY_CONFIG.read_text(),
                          kitty=KITTY_CONFIG.exists() and KITTY_INCLUDE in KITTY_CONFIG.read_text(),
                          foot=FOOT_CONFIG.exists() and FOOT_INCLUDE in FOOT_CONFIG.read_text(),
                          tmux=bool(tmux_config()) and TMUX_SOURCE in tmux_config().read_text()),
               live=dict(terminal_ptys=len(terminal_ptys()), neovim=len(nvim_sockets())),
               browsers=[dict(name=b, running=run) for b, _, run in browsers_found()],
               editors=[a for a, _, _ in editors_found()],
               icon_packs=dict(papirus="Papirus" in installed_icon_themes(),
                               yaru=any(n.startswith("Yaru") for n in installed_icon_themes()),
                               bibata=any(n.startswith("Bibata") for n in installed_icon_themes()),
                               adw_gtk3="adw-gtk3" in installed_gtk_themes()),
               themes=len(ts), wallpapers=sum(len(backgrounds(d)) for d in ts.values()), active=active_name())
    cov = []
    for n, d in ts.items():
        l, acc, mode = terminal_colors(d)
        cov.append(dict(name=n, colors=len(l), wallpapers=len(backgrounds(d)), nvim=nvim_scheme(d), mode=mode or "dark", full=len(l) >= 16))
    if as_json:
        print(json.dumps(dict(env=env, coverage=cov), indent=2))
        return
    ok = lambda b: "ok" if b else "missing"
    print()
    print(f" {B('DOCTOR')}  {D(env['app'])}")
    print(f" {rule()}")
    print(f"   {D('distro'):<14} {env['distro']}  {D('(arch family)') if env['arch_family'] else D('(non-arch: fine, GNOME is the only hard dependency)')}")
    print(f"   {D('gnome'):<14} {env['gnome']}  {D('·')} {env['session']}")
    print(f"   {D('python'):<14} {env['python']}   {D('git')} {ok(env['git'])}   {D('fzf')} {ok(env['fzf'])}   {D('gext')} {ok(env['gext'])}")
    print(f"   {D('ghostty'):<14} {ok(env['ghostty'])} {D('· hook')} {ok(env['ghostty_hook'])}     {D('nvim')} {ok(env['nvim'])} {D('· hook')} {ok(env['nvim_hook'])}     {D('btop')} {ok(env['btop'])}")
    st = env["extensions"]
    n_active = sum(1 for v in st.values() if v.upper() == "ACTIVE")
    n_pending = sum(1 for v in st.values() if v == "not loaded")
    n_stale = [u.split("@")[0] for u, v in st.items() if v.upper().startswith("OUT OF DATE")]
    n_missing = sum(1 for v in st.values() if v == "missing")
    ext_line = f"{n_active}/{len(EXTENSIONS)} active"
    if n_pending:
        ext_line += f" · {n_pending} load at next login"
    if n_stale:
        ext_line += f" · out of date: {', '.join(n_stale)}"
    if n_missing:
        ext_line += f" · {n_missing} missing  " + D("→ theme install")
    if n_pending:
        ext_line += "  " + D("→ log out and back in once")
    print(f"   {D('extensions'):<14} {ext_line}")
    if env["user_extensions_disabled"]:
        print(f"   {D('') :<14} user extensions are switched off globally (org.gnome.shell disable-user-extensions)  " + D("→ theme activate"))
    hk = env["hooks"]
    tline = " · ".join(f"{k} {'hook ok' if (k == 'ghostty' and env['ghostty_hook']) or hk.get(k) else ('present, no hook' if env['terminals'][k] else '-')}"
                       for k in ("ghostty", "alacritty", "kitty", "foot"))
    tline += " · tmux " + ("hook ok" if hk["tmux"] else ("opt-in" if not env["targets"]["tmux"] else ("present, no hook" if env["terminals"]["tmux"] else "-")))
    print(f"   {D('terminals'):<14} {tline}")
    print(f"   {D('live'):<14} {env['live']['terminal_ptys']} terminal pty(s) · {env['live']['neovim']} neovim socket(s)")
    br = ", ".join(f"{b['name']}{' (running)' if b['running'] else ''}" for b in env["browsers"]) or "-"
    print(f"   {D('browsers'):<14} {br}     {D('editors')} {', '.join(env['editors']) or '-'}")
    ip = env["icon_packs"]
    packs = " · ".join(f"{n} {'ok' if v else 'missing'}" for n, v in (("Papirus", ip["papirus"]), ("Yaru", ip["yaru"]), ("Bibata", ip["bibata"]), ("adw-gtk3", ip["adw_gtk3"])))
    print(f"   {D('icon packs'):<14} {packs}" + ("" if all(ip.values()) else "  " + D("→ theme icons")))
    off = [n for n, v in env["targets"].items() if not v]
    print(f"   {D('rotation'):<14} {env['rotation'] or 'off'}     {D('active')} {env['active']}" + (f"     {D('targets off')} {', '.join(off)}" if off else ""))
    full = sum(1 for c in cov if c["full"])
    print(f"   {D('library'):<14} {env['themes']} themes · {env['wallpapers']} wallpapers · full-palette {full}/{len(cov)}")
    bad = [c for c in cov if not c["full"]]
    if verbose or bad:
        print()
        for c in (cov if verbose else bad):
            print(f"     {c['name']:<24} colors={c['colors']:2} walls={c['wallpapers']:2} nvim={c['nvim'] or '-'} mode={c['mode']}")
    print()
    credit()


def cmd_rotate(arg):
    if arg in ("off", "stop"):
        userctl("disable", "--now", "wallpaper-rotate.timer")
        print("rotation: off")
        return
    try:
        m = int(arg.rstrip("m"))
    except ValueError:
        sys.exit("usage: theme rotate <minutes|off>")
    rotation_units(m)
    print(f"rotation: every {m} min")


def cmd_schedule(args):
    f = STATE / "schedule"
    if not args:
        print(("schedule: " + " · ".join(f.read_text().split())) if f.exists() else "schedule: none  (theme schedule set 07:00=catppuccin-latte 19:00=moodpeak)")
        return
    if args[0] == "off":
        f.unlink(missing_ok=True)
        userctl("disable", "--now", "theme-schedule.timer")
        print("schedule: off")
        return
    if args[0] == "apply":
        if not f.exists():
            return
        import datetime
        now = datetime.datetime.now().strftime("%H:%M")
        slots = sorted((s.split("=", 1) for s in f.read_text().split()), key=lambda s: s[0])
        due = [n for t, n in slots if t <= now] or [slots[-1][1]]
        if due[-1] != active_name():
            apply(due[-1], "first", quiet=True)
        return
    if args[0] == "set":
        slots = [a for a in args[1:] if re.fullmatch(r"\d\d:\d\d=[\w.-]+", a)]
        if not slots:
            sys.exit("usage: theme schedule set HH:MM=theme [HH:MM=theme …]")
        STATE.mkdir(parents=True, exist_ok=True)
        f.write_text(" ".join(slots) + "\n")
        unit_write("theme-schedule",
                   f"[Unit]\nDescription={APP}: apply the scheduled theme\n[Service]\nType=oneshot\nExecStart={SCRIPT} schedule apply\n",
                   f"[Unit]\nDescription={APP}: day/night theme schedule\n[Timer]\nOnBootSec=1min\nOnCalendar=*:0/5\n[Install]\nWantedBy=timers.target\n")
        userctl("enable", "--now", "theme-schedule.timer")
        print("schedule: " + " · ".join(slots) + D("  (checked every 5 min)"))
        return
    sys.exit("usage: theme schedule [set HH:MM=theme … | off]")


def cmd_export():
    print(json.dumps(dict(app=APP, version=VERSION, active=active_name(),
                          wallpaper=gget("org.gnome.desktop.background", "picture-uri-dark"),
                          schedule=(STATE / "schedule").read_text().split() if (STATE / "schedule").exists() else [],
                          local_manifest=(STATE / "manifest.local.txt").read_text().splitlines() if (STATE / "manifest.local.txt").exists() else []), indent=2))


def cmd_import(path):
    f = pathlib.Path(path)
    if not f.exists():
        sys.exit(f"no such file: {path}")
    try:
        d = json.loads(f.read_text())
    except json.JSONDecodeError as e:
        sys.exit(f"not valid JSON: {path} ({e.msg})")
    for line in d.get("local_manifest", []):
        parts = line.split()
        if len(parts) == 2 and not (THEMES / parts[0]).exists():
            clone(parts[1], THEMES / parts[0])
    if d.get("schedule"):
        cmd_schedule(["set"] + d["schedule"])
    if d.get("active"):
        apply(d["active"], "first")
    print("imported")


