# ─────────────────────────────── migration ───────────────────────────────────
def migrate():
    """One-time move from the pre-1.0 layout (omarchy-themes dirs)."""
    old_t = XDG_DATA / "omarchy-themes"
    old_s = XDG_CONFIG / "omarchy-themes"
    if old_t.exists() and not THEMES.exists():
        THEMES.parent.mkdir(parents=True, exist_ok=True)
        old_t.rename(THEMES)
    if old_s.exists() and not STATE.exists():
        STATE.parent.mkdir(parents=True, exist_ok=True)
        old_s.rename(STATE)
    STATE.mkdir(parents=True, exist_ok=True)


# ─────────────────────────────── ui ──────────────────────────────────────────
PLAIN = ("--plain" in sys.argv) or ("--json" in sys.argv)
DRY = "--dry-run" in sys.argv


def _color_ok():
    if os.environ.get("NO_COLOR") or PLAIN:
        return False
    return bool(os.environ.get("FORCE_COLOR")) or sys.stdout.isatty()


COLOR = _color_ok()


def _rgb(h):
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def bg(h, s="  "):
    if not COLOR or not h:
        return "  " if not h else s
    r, g, b = _rgb(h)
    return f"\x1b[48;2;{r};{g};{b}m{s}\x1b[0m"


def B(s):
    return f"\x1b[1m{s}\x1b[0m" if COLOR else s


def D(s):
    return f"\x1b[2m{s}\x1b[0m" if COLOR else s


def width():
    return min(shutil.get_terminal_size((100, 40)).columns, 110)


def rule():
    return D("─" * (width() - 2))


def credit():
    """Dim attribution footer on human-facing output (never on --plain/--json)."""
    if not PLAIN and sys.stdout.isatty():
        print(f" {D(APP + ' v' + VERSION + ' · ' + CREDIT)}")


def gset(schema, key, val, schemadir=None):
    if DRY:
        print(f"  [dry-run] gsettings set {schema} {key} {val}")
        return True
    cmd = ["gsettings"] + (["--schemadir", str(schemadir)] if schemadir else []) + ["set", schema, key, val]
    return subprocess.run(cmd, capture_output=True, text=True).returncode == 0


def userctl(*args):
    """systemctl --user for state-changing calls; a no-op under --dry-run."""
    if DRY:
        print("  [dry-run] systemctl --user " + " ".join(args))
        return True
    return subprocess.run(["systemctl", "--user", *args], capture_output=True).returncode == 0


def greset(schema, key):
    if DRY:
        print(f"  [dry-run] gsettings reset {schema} {key}")
        return True
    return subprocess.run(["gsettings", "reset", schema, key], capture_output=True).returncode == 0


def gget(schema, key):
    r = subprocess.run(["gsettings", "get", schema, key], capture_output=True, text=True)
    return r.stdout.strip().strip("'") if r.returncode == 0 else ""


# ─────────────────────────────── themes ──────────────────────────────────────
def themes():
    d = {}
    if OFFICIAL.exists():
        for p in sorted(OFFICIAL.iterdir()):
            if p.is_dir():
                d[p.name] = p
    if THEMES.exists():
        for p in sorted(THEMES.iterdir()):
            if p.is_dir() and not p.name.startswith("_"):
                d.setdefault(p.name, p)
    return d


def is_official(p):
    return str(p).startswith(str(OFFICIAL))


def backgrounds(dirp):
    b = dirp / "backgrounds"
    if not b.exists():
        return []
    return sorted(f for f in b.rglob("*") if f.is_file() and f.suffix.lower() in IMG)


def active_name():
    f = STATE / "active"
    return f.read_text().strip() if f.exists() else "graphite"


# ─────────────────────────────── color extraction ────────────────────────────
def _hex(v):
    v = str(v).strip().strip('"').strip("'")
    return v if re.fullmatch(r"#?[0-9a-fA-F]{6}", v) else None


def colors_toml_lines(dirp):
    """Omarchy 4 colors.toml — named-key dialect and color0-15 dialect. → (lines, accent, mode)"""
    f = dirp / "colors.toml"
    if not f.exists():
        return [], None, None
    try:
        c = tomllib.loads(f.read_text(errors="ignore"))
    except Exception:
        return [], None, None

    def g(*ks):
        for k in ks:
            if k in c and _hex(c[k]):
                return _hex(c[k])
        return None

    out = []
    bgc, fgc = g("background"), g("foreground")
    if bgc:
        out.append(f"background = {bgc}")
    if fgc:
        out.append(f"foreground = {fgc}")
    cur = g("cursor", "accent")
    if cur:
        out.append(f"cursor-color = {cur}")
    sb = g("selection_background", "selection")
    if sb:
        out.append(f"selection-background = {sb}")
    sf = g("selection_foreground")
    if sf:
        out.append(f"selection-foreground = {sf}")
    if any(f"color{i}" in c for i in range(16)):
        for i in range(16):
            v = g(f"color{i}")
            if v:
                out.append(f"palette = {i}={v}")
    else:
        pal = [g("darker_background", "dark_background", "background"), g("red"), g("green"), g("yellow"),
               g("blue"), g("magenta"), g("cyan"), g("light_foreground", "foreground"),
               g("muted", "dark_foreground"), g("bright_red", "red"), g("bright_green", "green"),
               g("bright_yellow", "yellow"), g("bright_blue", "blue"), g("bright_magenta", "magenta"),
               g("bright_cyan", "cyan"), g("bright_foreground", "foreground")]
        for i, v in enumerate(pal):
            if v:
                out.append(f"palette = {i}={v}")
    mode = str(c.get("mode", "")).strip('"').lower() or None
    return out, g("accent"), mode


def ghostty_lines(dirp):
    g = dirp / "ghostty.conf"
    if not g.exists():
        return []
    out = []
    for line in g.read_text(errors="ignore").splitlines():
        s = line.strip()
        if not s or s.startswith("#") or "=" not in s:
            continue
        if s.split("=", 1)[0].strip() in WHITELIST:
            out.append(s)
    return out


def alacritty_lines(dirp):
    a = dirp / "alacritty.toml"
    if not a.exists():
        return []
    try:
        c = tomllib.loads(a.read_text(errors="ignore")).get("colors", {})
    except Exception:
        return []
    out = []
    p, cur, sel = c.get("primary", {}), c.get("cursor", {}), c.get("selection", {})
    if "background" in p:
        out.append(f"background = {p['background']}")
    if "foreground" in p:
        out.append(f"foreground = {p['foreground']}")
    if "cursor" in cur:
        out.append(f"cursor-color = {cur['cursor']}")
    if "background" in sel:
        out.append(f"selection-background = {sel['background']}")
    if "foreground" in sel:
        out.append(f"selection-foreground = {sel['foreground']}")
    names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    for base, grp in ((0, "normal"), (8, "bright")):
        for i, n in enumerate(names):
            v = c.get(grp, {}).get(n)
            if v:
                out.append(f"palette = {base + i}={v}")
    return out


def kitty_lines(dirp):
    f = dirp / "kitty.conf"
    if not f.exists():
        return []
    km = {"background": "background", "foreground": "foreground", "cursor": "cursor-color",
          "selection_background": "selection-background", "selection_foreground": "selection-foreground"}
    out = []
    for line in f.read_text(errors="ignore").splitlines():
        m = re.match(r"^\s*(\w+)\s+(#[0-9a-fA-F]{6})", line)
        if not m:
            continue
        k, v = m.groups()
        if k in km:
            out.append(f"{km[k]} = {v}")
        elif re.fullmatch(r"color(\d|1[0-5])", k):
            out.append(f"palette = {k[5:]}={v}")
    return out


def terminal_colors(dirp):
    """Priority: colors.toml → ghostty.conf → alacritty.toml → kitty.conf. → (lines, accent, mode)"""
    lines, acc, mode = colors_toml_lines(dirp)
    if len(lines) >= 8:
        return lines, acc, mode
    for fn in (ghostty_lines, alacritty_lines, kitty_lines):
        cand = fn(dirp)
        if len(cand) >= 8:
            return cand, acc, mode
    return lines or ghostty_lines(dirp) or alacritty_lines(dirp) or kitty_lines(dirp), acc, mode


def palette_of(lines):
    pal, meta = {}, {}
    for l in lines:
        m = re.match(r"palette\s*=\s*(\d+)=(#?[0-9a-fA-F]{6})", l)
        if m:
            pal[int(m.group(1))] = "#" + m.group(2).lstrip("#")
            continue
        m = re.match(r"(background|foreground|cursor-color|cursor-text|selection-background|selection-foreground)\s*=\s*(#?[0-9a-fA-F]{6})", l)
        if m:
            meta[m.group(1)] = "#" + m.group(2).lstrip("#")
    return pal, meta


def hue_to_accent(col):
    h = col.lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
    hue, light, sat = colorsys.rgb_to_hls(r, g, b)
    if sat < 0.15:
        return "slate"
    deg = hue * 360
    table = [(0, "red"), (25, "orange"), (50, "yellow"), (110, "green"), (170, "teal"),
             (225, "blue"), (275, "purple"), (320, "pink"), (360, "red")]
    return min(table, key=lambda t: abs(t[0] - deg))[1]


def accent_from(lines):
    for pat in (r"palette\s*=\s*4=(#?[0-9a-fA-F]{6})", r"cursor-color\s*=\s*(#?[0-9a-fA-F]{6})"):
        for l in lines:
            m = re.match(pat, l)
            if m:
                return hue_to_accent(m.group(1))
    return None


def nvim_scheme(dirp):
    n = dirp / "neovim.lua"
    if not n.exists():
        return None
    m = re.search(r'colorscheme\s*=\s*"([^"]+)"', n.read_text(errors="ignore"))
    return m.group(1) if m else None


NVIM_CANVAS = ("Normal", "NormalNC", "EndOfBuffer", "SignColumn", "LineNr", "LineNrAbove", "LineNrBelow",
               "FoldColumn", "MsgArea")

NVIM_HOOK_TEMPLATE = """-- colson-arch-theme · theme: @NAME@ · mode: @MODE@ · terminal background @BG@ · foreground @FG@
-- Written by `theme @NAME@`, rewritten on every switch, removed by `theme uninstall`.
local scheme, mode = @SCHEME@, "@MODE@"
local canvas = { @GROUPS@ }

-- Drop only a group's background; every other attribute survives.
local function clear_bg(group)
  if not vim.api.nvim_get_hl then return end
  local ok, hl = pcall(vim.api.nvim_get_hl, 0, { name = group, link = false })
  if not ok or type(hl) ~= "table" then return end
  hl.bg, hl.ctermbg = nil, nil
  pcall(vim.api.nvim_set_hl, 0, group, hl)
end

-- The editor canvas becomes the terminal surface, but only when both agree on light/dark.
local function align()
  if vim.o.background ~= mode then return end
  for _, g in ipairs(canvas) do clear_bg(g) end
end

local function apply()
  if scheme then pcall(vim.cmd.colorscheme, scheme) end
  align()
end

-- VimEnter runs after every startup script, so nothing in your own config can clobber this;
-- ColorScheme keeps the canvas aligned after any later switch.
local group = vim.api.nvim_create_augroup("ColsonArchTheme", { clear = true })
vim.api.nvim_create_autocmd("ColorScheme", { group = group, callback = align })
if vim.v.vim_did_enter == 1 then apply() else
  vim.api.nvim_create_autocmd("VimEnter", { group = group, once = true, callback = apply })
end
"""


def nvim_hook_write(name, scheme, lines, mode):
    """Write the Neovim hook: the declared colorscheme at VimEnter (after every startup script, so the
    user's own plugins cannot clobber it), the editor canvas cleared to the terminal surface whenever the
    theme and the editor agree on light/dark, re-aligned on every later :colorscheme. The scheme name is
    whitelisted before it reaches Lua — a theme bundle is data, never code."""
    if scheme and not re.fullmatch(r"[A-Za-z0-9_.-]+", scheme):
        scheme = None
    _, meta = palette_of(lines)
    lua = (NVIM_HOOK_TEMPLATE.replace("@NAME@", name).replace("@MODE@", mode)
           .replace("@BG@", meta.get("background", "-")).replace("@FG@", meta.get("foreground", "-"))
           .replace("@SCHEME@", f'"{scheme}"' if scheme else "nil")
           .replace("@GROUPS@", ", ".join(f'"{g}"' for g in NVIM_CANVAS)))
    NVIM_HOOK.parent.mkdir(parents=True, exist_ok=True)
    NVIM_HOOK.write_text(lua)


# ─────────────────────────────── targets ─────────────────────────────────────
TARGETS = [  # name, default, what `theme <name>` touches
    ("wallpaper", True, "GNOME wallpaper, its dark variant and the lock screen"),
    ("shell", True, "generated GNOME Shell theme, selected through User Themes"),
    ("gtk", True, "GTK4/GTK3 apps: shipped gtk.css or generated libadwaita colors; adw-gtk3 by mode"),
    ("accent", True, "GNOME accent color, light/dark color-scheme, fallback desktop color"),
    ("icons", True, "icon theme: the declared Yaru variant, else Papirus with accent-colored folders"),
    ("cursor", True, "Bibata cursor: Ice on dark themes, Classic on light"),
    ("ghostty", True, "Ghostty palette include"),
    ("alacritty", True, "Alacritty colors import"),
    ("kitty", True, "Kitty colors include"),
    ("foot", True, "foot colors include"),
    ("tmux", False, "tmux status line, borders, messages, copy mode (opt-in: your own status design wins by default)"),
    ("nvim", True, "Neovim: declared colorscheme at VimEnter, canvas aligned to the terminal"),
    ("btop", True, "btop theme"),
    ("browser", True, "Chromium / Chrome / Brave frame color, applied to a running browser"),
    ("vscode", True, "VS Code / Cursor / VSCodium colorTheme, only when that theme's extension is already installed"),
    ("live", True, "instant recolor of every open terminal (OSC), Neovim (RPC) and tmux; nothing to reload"),
]
TARGET_DEFAULT = {n: d for n, d, _ in TARGETS}
TARGETS_FILE = STATE / "targets"


def targets_state():
    st = dict(TARGET_DEFAULT)
    if TARGETS_FILE.exists():
        for line in TARGETS_FILE.read_text().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                if k.strip() in st:
                    st[k.strip()] = v.strip().lower() in ("on", "true", "1", "yes")
    return st


def cmd_target(args):
    st = targets_state()
    if not args or args[0] in ("list", "show"):
        print()
        print(f" {B('targets')}   {D('what `theme <name>` is allowed to touch  ·  theme target on|off <name>')}")
        print(f" {rule()}")
        for n, d, what in TARGETS:
            flag = "on " if st[n] else "off"
            note = "" if st[n] == d else D("  (default " + ("on" if d else "off") + ")")
            print(f"   {n:<10} {flag}  {D(what)}{note}")
        print()
        credit()
        return
    if len(args) == 2 and args[0] in ("on", "off") and args[1] in st:
        st[args[1]] = args[0] == "on"
        STATE.mkdir(parents=True, exist_ok=True)
        TARGETS_FILE.write_text("".join(f"{k}={'on' if v else 'off'}\n" for k, v in st.items() if v != TARGET_DEFAULT[k]))
        hint = "  (theme install wires its hook; theme <name> applies it)" if args[0] == "on" and args[1] in ("tmux", "alacritty", "kitty", "foot") else ""
        print(f"target {args[1]}: {args[0]}{hint}")
        return
    sys.exit("usage: theme target [on|off <name>]      (theme targets)")


# ─────────────────────────────── palette ─────────────────────────────────────
def full_palette(lines):
    """Every slot filled: theme values first, Graphite for anything a bundle left out."""
    pal, meta = palette_of(lines)
    gp, gm = palette_of(GRAPHITE_LINES)
    p = [pal.get(i) or gp[i] for i in range(16)]
    return dict(bg=meta.get("background") or gm["background"], fg=meta.get("foreground") or gm["foreground"],
                cursor=meta.get("cursor-color") or meta.get("foreground") or gm["cursor-color"],
                sel_bg=meta.get("selection-background") or p[8], sel_fg=meta.get("selection-foreground"), p=p)


def tilde(path):
    try:
        return "~/" + str(pathlib.Path(path).relative_to(HOME))
    except ValueError:
        return str(path)


# ─────────────────────────────── terminals: fragments ────────────────────────
def alacritty_fragment(name, lines):
    if not lines:
        return f"# {APP}: graphite — your own Alacritty colors rule ({MANAGED})\n"
    c = full_palette(lines)
    names = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]
    out = [f"# {APP}: theme {name} — {MANAGED}", "[colors.primary]", f'background = "{c["bg"]}"', f'foreground = "{c["fg"]}"',
           "[colors.cursor]", f'cursor = "{c["cursor"]}"', 'text = "CellBackground"',
           "[colors.selection]", f'background = "{c["sel_bg"]}"', f'text = "{c["sel_fg"] or "CellForeground"}"']
    for base, grp in ((0, "normal"), (8, "bright")):
        out.append(f"[colors.{grp}]")
        out += [f'{n} = "{c["p"][base + i]}"' for i, n in enumerate(names)]
    return "\n".join(out) + "\n"


def kitty_fragment(name, lines):
    if not lines:
        return f"# {APP}: graphite — your own kitty colors rule ({MANAGED})\n"
    c = full_palette(lines)
    out = [f"# {APP}: theme {name} — {MANAGED}", f"background {c['bg']}", f"foreground {c['fg']}", f"cursor {c['cursor']}",
           f"selection_background {c['sel_bg']}"] + ([f"selection_foreground {c['sel_fg']}"] if c["sel_fg"] else [])
    out += [f"color{i} {c['p'][i]}" for i in range(16)]
    return "\n".join(out) + "\n"


def foot_fragment(name, lines):
    if not lines:
        return f"# {APP}: graphite — your own foot colors rule ({MANAGED})\n"
    c = full_palette(lines)
    h = lambda x: x.lstrip("#")
    out = [f"# {APP}: theme {name} — {MANAGED}", "[colors]", f"background={h(c['bg'])}", f"foreground={h(c['fg'])}",
           f"selection-background={h(c['sel_bg'])}"] + ([f"selection-foreground={h(c['sel_fg'])}"] if c["sel_fg"] else [])
    out += [f"regular{i}={h(c['p'][i])}" for i in range(8)] + [f"bright{i}={h(c['p'][8 + i])}" for i in range(8)]
    out += ["[cursor]", f"color={h(c['bg'])} {h(c['cursor'])}"]
    return "\n".join(out) + "\n"


def tmux_fragment(name, lines, decl_acc, mode):
    c = scheme_from(lines or GRAPHITE_LINES, decl_acc, mode)
    p = full_palette(lines or GRAPHITE_LINES)
    dim = _mix(c["fg"], c["bg"], 0.35)
    return "\n".join([
        f"# {APP}: theme {name} — {MANAGED}",
        f'set -g status-style "bg={c["bg"]},fg={c["fg"]}"',
        f'set -g window-status-style "fg={dim},bg=default"',
        f'set -g window-status-current-style "fg={c["acc_fg"]},bg={c["acc"]},bold"',
        f'set -g window-status-activity-style "fg={c["acc"]},bold"',
        f'set -g pane-border-style "fg={_mix(c["bg"], c["fg"], 0.18)}"',
        f'set -g pane-active-border-style "fg={c["acc"]}"',
        f'set -g message-style "bg={c["surface2"]},fg={c["fg"]}"',
        f'set -g message-command-style "bg={c["surface2"]},fg={c["fg"]}"',
        f'set -g mode-style "bg={p["sel_bg"]},fg={p["sel_fg"] or c["fg"]}"',
        f'set -g clock-mode-colour "{c["acc"]}"',
        f'set -g display-panes-active-colour "{c["acc"]}"',
        f'set -g display-panes-colour "{dim}"',
    ]) + "\n"


# ─────────────────────────────── terminals: hooks ────────────────────────────
def _wire(path, line, comment, top=False):
    """Add one hook line, once. → wired | already | missing"""
    if not path.exists():
        return "missing"
    s = path.read_text()
    if line in s:
        return "already"
    block = f"# {APP}: {comment}\n{line}\n"
    path.write_text((block + "\n" + s) if top else (s.rstrip() + "\n\n" + block))
    return "wired"


def _unwire(path, line):
    if not path.exists():
        return
    s = path.read_text()
    if line not in s and f"# {APP}:" not in s:
        return
    keep = [l for l in s.splitlines() if l.strip() != line.strip() and not l.startswith(f"# {APP}:")]
    path.write_text("\n".join(keep).rstrip() + "\n")


ALACRITTY_IMPORT = f'"{tilde(ALACRITTY_ACTIVE)}"'
KITTY_INCLUDE = f"include {APP}.conf"
FOOT_INCLUDE = f"include={FOOT_ACTIVE}"
TMUX_SOURCE = f"source-file -q {TMUX_ACTIVE}"


def hook_alacritty():
    if not ALACRITTY_CONFIG.exists():
        return "alacritty: no alacritty.toml — skipped"
    s = ALACRITTY_CONFIG.read_text()
    if ALACRITTY_IMPORT in s:
        status = "import already wired"
    else:
        empty = re.search(r"^(\s*import\s*=\s*\[)\s*\]", s, re.M)
        m = re.search(r"^\s*import\s*=\s*\[", s, re.M)
        if empty:
            s = s[:empty.start()] + empty.group(1) + ALACRITTY_IMPORT + "]" + s[empty.end():]
        elif m:
            s = s[:m.end()] + ALACRITTY_IMPORT + ", " + s[m.end():]
        elif re.search(r"^\[general\]\s*$", s, re.M):
            s = re.sub(r"^\[general\]\s*$", f"[general]\nimport = [{ALACRITTY_IMPORT}]", s, count=1, flags=re.M)
        else:
            s = s.rstrip() + f"\n\n# {APP}: active theme colors (empty file = your own colors)\n[general]\nimport = [{ALACRITTY_IMPORT}]\n"
        ALACRITTY_CONFIG.write_text(s)
        status = "import wired"
    if not ALACRITTY_ACTIVE.exists():
        ALACRITTY_ACTIVE.write_text(alacritty_fragment("graphite", []))
    return "alacritty: " + status


def unhook_alacritty():
    if not ALACRITTY_CONFIG.exists():
        return
    s = ALACRITTY_CONFIG.read_text()
    s = s.replace(f"\n\n# {APP}: active theme colors (empty file = your own colors)\n[general]\nimport = [{ALACRITTY_IMPORT}]\n", "\n")
    s = s.replace(ALACRITTY_IMPORT + ", ", "").replace(", " + ALACRITTY_IMPORT, "").replace(ALACRITTY_IMPORT, "")
    s = re.sub(r"^\s*import\s*=\s*\[\s*,?\s*\]\s*\n", "", s, flags=re.M)   # an array we emptied is not worth keeping
    ALACRITTY_CONFIG.write_text(s.rstrip() + "\n")
    ALACRITTY_ACTIVE.unlink(missing_ok=True)


def hook_kitty():
    r = _wire(KITTY_CONFIG, KITTY_INCLUDE, "active theme colors (empty file = your own colors)")
    if r == "missing":
        return "kitty: no kitty.conf — skipped"
    if not KITTY_ACTIVE.exists():
        KITTY_ACTIVE.write_text(kitty_fragment("graphite", []))
    return f"kitty: include " + ("already wired" if r == "already" else r)


def hook_foot():
    r = _wire(FOOT_CONFIG, FOOT_INCLUDE, "active theme colors (empty file = your own colors)", top=True)
    if r == "missing":
        return "foot: no foot.ini — skipped"
    if not FOOT_ACTIVE.exists():
        FOOT_ACTIVE.write_text(foot_fragment("graphite", []))
    return f"foot: include " + ("already wired" if r == "already" else r)


def tmux_config():
    return next((p for p in TMUX_CONFIGS if p.exists()), None)


def hook_tmux():
    if not targets_state()["tmux"]:
        return "tmux: opt-in — `theme target on tmux` to theme the status line"
    conf = tmux_config()
    if not conf:
        return "tmux: no tmux.conf — skipped"
    r = _wire(conf, TMUX_SOURCE, "active theme for the status line, borders and messages")
    if not TMUX_ACTIVE.exists():
        TMUX_ACTIVE.parent.mkdir(parents=True, exist_ok=True)
        TMUX_ACTIVE.write_text(tmux_fragment("graphite", [], "#ffffff", "dark"))
    return "tmux: source-file " + ("already wired" if r == "already" else r)


# ─────────────────────────────── live: terminals, neovim, tmux ───────────────
TERMINALS = ("ghostty", "kitty", "alacritty", "foot", "footclient", "wezterm-gui", "gnome-terminal-server",
             "ptyxis-agent", "konsole", "xfce4-terminal", "tilix", "blackbox", "rio", "contour", "warp-terminal")
ST = "\x1b\\"


def osc_payload(lines):
    """OSC 10/11/12/17 + OSC 4 for the 16 slots; with no lines, the reset forms (104/110/111/112/117) so
    every terminal returns to its own configured colors — under Graphite that is the base config."""
    if not lines:
        return "".join(f"\x1b]{n}{ST}" for n in (104, 110, 111, 112, 117)).encode()
    c = full_palette(lines)
    seq = [f"\x1b]10;{c['fg']}{ST}", f"\x1b]11;{c['bg']}{ST}", f"\x1b]12;{c['cursor']}{ST}", f"\x1b]17;{c['sel_bg']}{ST}"]
    seq += [f"\x1b]4;{i};{c['p'][i]}{ST}" for i in range(16)]
    return "".join(seq).encode()


def terminal_ptys():
    """Controlling ttys of the shells that running terminal emulators spawned — this user only."""
    try:
        ps = subprocess.run(["ps", "-o", "pid=,ppid=,tty=,comm=", "-u", str(os.getuid())],
                            capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    rows = [r.split(None, 3) for r in ps.splitlines()]
    rows = [r for r in rows if len(r) == 4]
    short = {t[:15] for t in TERMINALS}
    term = {pid for pid, ppid, tty, comm in rows if comm[:15] in short}
    return sorted({f"/dev/{tty}" for pid, ppid, tty, comm in rows if ppid in term and tty.startswith("pts/")})


def terminals_live(lines):
    payload, n = osc_payload(lines), 0
    for pty in terminal_ptys():
        if DRY:
            print(f"  [dry-run] recolor {pty} (OSC {'reset' if not lines else '4/10/11/12'})")
            n += 1
            continue
        try:
            fd = os.open(pty, os.O_WRONLY | os.O_NOCTTY | os.O_NONBLOCK)
            try:
                os.write(fd, payload)
            finally:
                os.close(fd)
            n += 1
        except OSError:
            pass
    return n


def nvim_sockets():
    socks = list(RUNTIME.glob("nvim.*.0")) if RUNTIME.exists() else []
    legacy = pathlib.Path(os.environ.get("TMPDIR", "/tmp")) / f"nvim.{os.environ.get('USER', '')}"
    if legacy.exists():
        socks += list(legacy.glob("*/nvim.*.0"))
    return [s for s in socks if s.is_socket()]


def nvim_live():
    """Re-run the hook inside every running Neovim over its RPC socket — no keys are sent, no mode changes."""
    n = 0
    if not shutil.which("nvim"):
        return 0
    for sock in nvim_sockets():
        if DRY:
            print(f"  [dry-run] nvim --server {sock} --remote-expr luafile {NVIM_HOOK}")
            n += 1
            continue
        try:
            r = subprocess.run(["nvim", "--server", str(sock), "--remote-expr", f"execute('luafile {NVIM_HOOK}')"],
                               capture_output=True, text=True, timeout=3)
            n += r.returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            pass
    return n


def tmux_live():
    if not shutil.which("tmux") or not TMUX_ACTIVE.exists():
        return False
    if DRY:
        print(f"  [dry-run] tmux source-file {TMUX_ACTIVE}")
        return True
    if subprocess.run(["tmux", "list-sessions"], capture_output=True).returncode != 0:
        return False
    return subprocess.run(["tmux", "source-file", "-q", str(TMUX_ACTIVE)], capture_output=True).returncode == 0


# ─────────────────────────────── browser frame ───────────────────────────────
BROWSERS = (("chromium", "chromium"), ("google-chrome-stable", "chrome"), ("google-chrome", "chrome"),
            ("brave", "brave"), ("brave-browser", "brave"), ("vivaldi-stable", "vivaldi-bin"), ("microsoft-edge-stable", "msedge"))


def browser_rgb(dirp, lines):
    """R,G,B for --set-theme-color: the bundle's chromium.theme when it holds one, else the background."""
    f = dirp / "chromium.theme" if dirp else None
    if f and f.exists():
        m = re.fullmatch(r"\s*(\d{1,3}),(\d{1,3}),(\d{1,3})\s*", f.read_text(errors="ignore"))
        if m and all(int(x) <= 255 for x in m.groups()):
            return ",".join(m.groups())
    return ",".join(str(x) for x in _rgb(full_palette(lines or GRAPHITE_LINES)["bg"]))


def browsers_found():
    seen, out = set(), []
    for binary, proc in BROWSERS:
        exe = shutil.which(binary)
        if exe and proc not in seen:
            seen.add(proc)
            running = subprocess.run(["pgrep", "-x", proc], capture_output=True).returncode == 0
            out.append((binary, exe, running))
    return out


def browsers_apply(rgb):
    """The frame color is handed to the browser's own IPC (--set-theme-color) — only to a running browser,
    so nothing is launched behind your back. It persists in the profile once set."""
    done = []
    for binary, exe, running in browsers_found():
        if not running:
            continue
        if DRY:
            print(f"  [dry-run] {binary} --no-startup-window --set-theme-color={rgb}")
            done.append(binary)
            continue
        try:
            subprocess.Popen([exe, "--no-startup-window", f"--set-theme-color={rgb}"],
                             stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            done.append(binary)
        except OSError:
            pass
    return done


# ─────────────────────────────── editors: vs code family ─────────────────────
EDITORS = (("Code", ".vscode"), ("Cursor", ".cursor"), ("VSCodium", ".vscode-oss"), ("Code - OSS", ".vscode-oss"))
VSCODE_PREV = STATE / "vscode.prev"


def vscode_decl(dirp):
    f = dirp / "vscode.json"
    if not f.exists():
        return None, None
    try:
        d = json.loads(f.read_text(errors="ignore"))
    except (json.JSONDecodeError, UnicodeDecodeError):
        return None, None
    name, ext = str(d.get("name", "")).strip(), str(d.get("extension", "")).strip().lower()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]*\.[a-z0-9][a-z0-9-]*", ext) or not re.fullmatch(r"[\w .+()'’-]{1,80}", name):
        return None, None
    return name, ext


def _settings_get_theme(path):
    m = re.search(r'"workbench\.colorTheme"\s*:\s*"([^"]*)"', path.read_text(errors="ignore"))
    return m.group(1) if m else ""


def _settings_set_theme(path, name):
    """Touch only the colorTheme key; comments and trailing commas elsewhere are left exactly as they were."""
    s = path.read_text()
    esc = name.replace("\\", "\\\\").replace('"', '\\"')
    if re.search(r'"workbench\.colorTheme"\s*:\s*"[^"]*"', s):
        s2 = re.sub(r'("workbench\.colorTheme"\s*:\s*)"[^"]*"', lambda m: m.group(1) + f'"{esc}"', s, count=1)
    else:
        body = s.rstrip()
        if not body.endswith("}"):
            return False
        inner = body[:-1].rstrip()
        sep = "" if inner.endswith(("{", ",")) else ","
        s2 = inner + f'{sep}\n  "workbench.colorTheme": "{esc}"\n}}\n'
    if s2 != s:
        path.write_text(s2)
    return True


def editors_found():
    out = []
    for app_dir, ext_home in EDITORS:
        settings = XDG_CONFIG / app_dir / "User" / "settings.json"
        if settings.exists():
            out.append((app_dir, settings, HOME / ext_home / "extensions"))
    return out


def editors_apply(name, ext):
    """Set the editor's colorTheme only where that theme's extension is already installed. Never installs anything;
    remembers what was there so Graphite and uninstall can put it back."""
    prev = json.loads(VSCODE_PREV.read_text()) if VSCODE_PREV.exists() else {}
    done = []
    for app_dir, settings, ext_dir in editors_found():
        if not ext_dir.exists() or not any(p.name.lower().startswith(ext + "-") for p in ext_dir.iterdir()):
            continue
        if DRY:
            print(f"  [dry-run] {app_dir}: workbench.colorTheme = {name}")
            done.append(app_dir)
            continue
        prev.setdefault(app_dir, _settings_get_theme(settings))
        if _settings_set_theme(settings, name):
            done.append(app_dir)
    if done and not DRY:
        STATE.mkdir(parents=True, exist_ok=True)
        VSCODE_PREV.write_text(json.dumps(prev))
    return done


def editors_restore():
    if not VSCODE_PREV.exists():
        return []
    prev, done = json.loads(VSCODE_PREV.read_text()), []
    for app_dir, old in prev.items():
        settings = XDG_CONFIG / app_dir / "User" / "settings.json"
        if settings.exists() and old:
            if DRY:
                print(f"  [dry-run] {app_dir}: workbench.colorTheme = {old} (restored)")
            else:
                _settings_set_theme(settings, old)
            done.append(app_dir)
    if not DRY:
        VSCODE_PREV.unlink(missing_ok=True)
    return done


# ─────────────────────────────── icons, cursor, gtk3 ─────────────────────────
YARU_VARIANTS = {"Yaru-blue": "#0073e5", "Yaru-red": "#e6323c", "Yaru-magenta": "#c33d76", "Yaru-purple": "#7764d8",
                 "Yaru-olive": "#4b8501", "Yaru-sage": "#657b69", "Yaru-prussiangreen": "#308280", "Yaru-viridian": "#03875b",
                 "Yaru-wartybrown": "#75542a", "Yaru-yellow": "#f5c211", "Yaru": "#e95420", "Yaru-bark": "#787859",
                 "Yaru-grey": "#8c8c8c"}
PAPIRUS_FOLDERS = {"red": "#f44336", "carmine": "#b71c1c", "deeporange": "#ff5722", "orange": "#ff9800", "paleorange": "#ffcc80",
                   "yaru": "#e95420", "brown": "#ae8e6c", "palebrown": "#d7ccc8", "yellow": "#ffc107", "green": "#87b158",
                   "teal": "#009688", "darkcyan": "#00838f", "cyan": "#00bcd4", "breeze": "#3daee9", "nordic": "#81a1c1",
                   "blue": "#5294e2", "adwaita": "#3584e4", "indigo": "#5c6bc0", "violet": "#7e57c2", "magenta": "#d53a9d",
                   "pink": "#f06292", "bluegrey": "#607d8b", "grey": "#8e8e8e", "black": "#4f4f4f", "white": "#e4e4e4"}


def nearest_name(hexcol, table):
    """Nearest named color. Colorfulness is judged by RGB chroma (max-min), not HLS saturation, which
    inflates for near-black values; hue then dominates for colorful inputs, lightness for greys."""
    def parts(hx):
        r, g, b = (x / 255 for x in _rgb(hx))
        h, l, _ = colorsys.rgb_to_hls(r, g, b)
        return h, l, max(r, g, b) - min(r, g, b)
    h, l, ch = parts(hexcol)
    colorful = ch > 0.18

    def dist(other):
        h2, l2, ch2 = parts(other)
        if colorful != (ch2 > 0.18):
            return 9.0                     # colorful accents stay among colorful variants, greys among greys
        if colorful:
            dh = min(abs(h - h2), 1 - abs(h - h2)) * 3.0
            return dh * dh + (l - l2) ** 2 * 0.15          # hue decides; lightness only breaks ties
        return (l - l2) ** 2 * 0.6 + (ch - ch2) ** 2 * 0.4  # greys: lightness decides
    return min(table, key=lambda n: dist(table[n]))


def installed_icon_themes():
    names = set()
    for base in ICON_DIRS:
        if base.exists():
            names |= {d.name for d in base.iterdir() if (d / "index.theme").exists()}
    return names


def installed_gtk_themes():
    names = set()
    for base in THEME_DIRS:
        if base.exists():
            names |= {d.name for d in base.iterdir() if d.is_dir()}
    return names


def papirus_overlay(c):
    """A user-level icon theme that inherits Papirus (Dark or Light by mode) and swaps every folder icon for the
    variant nearest the accent — Papirus ships all the colors; only symlinks and an index are created."""
    import configparser
    root = next((b for b in ICON_DIRS if (b / "Papirus" / "index.theme").exists()), None)
    if not root:
        return None
    color = nearest_name(c["acc"], PAPIRUS_FOLDERS)
    papirus = root / "Papirus"
    name = f"{APP}-papirus-{color}" + ("" if c["light"] else "-dark")
    dest = XDG_DATA / "icons" / name
    cp = configparser.ConfigParser(interpolation=None, strict=False)
    cp.optionxform = str
    try:
        cp.read(papirus / "index.theme", encoding="utf-8")
    except configparser.Error:
        return None
    dirs = [d.strip() for d in cp.get("Icon Theme", "Directories", fallback="").split(",") if d.strip()]
    if dest.exists():
        shutil.rmtree(dest, ignore_errors=True)
    sections, made = [], 0
    for d in dirs:
        if not cp.has_section(d) or cp.get(d, "Context", fallback="") != "Places":
            continue
        srcdir = papirus / d
        if not srcdir.is_dir():
            continue
        colored = sorted(srcdir.glob(f"folder-{color}*.svg"))
        if not colored:
            continue
        (dest / d).mkdir(parents=True, exist_ok=True)
        for f in colored:
            (dest / d / f.name.replace(f"folder-{color}", "folder", 1)).symlink_to(f.resolve())
            made += 1
        sections.append(d)
    if not made:
        shutil.rmtree(dest, ignore_errors=True)
        return None
    inherits = "Papirus,breeze,hicolor" if c["light"] else "Papirus-Dark,Papirus,breeze-dark,hicolor"
    idx = ["[Icon Theme]", f"Name={name}", f"Comment=Papirus with {color} folders, generated by {APP}",
           f"Inherits={inherits}", f"Directories={','.join(sections)}", ""]
    for d in sections:
        idx.append(f"[{d}]")
        idx += [f"{k}={cp.get(d, k)}" for k in ("Size", "Context", "Type", "MinSize", "MaxSize", "Scale") if cp.has_option(d, k)]
        idx.append("")
    (dest / "index.theme").write_text("\n".join(idx))
    if shutil.which("gtk-update-icon-cache"):
        subprocess.run(["gtk-update-icon-cache", "-f", "-t", "-q", str(dest)], capture_output=True)
    for old in (XDG_DATA / "icons").glob(f"{APP}-papirus-*"):
        if old != dest:
            shutil.rmtree(old, ignore_errors=True)
    return name


def icons_clear():
    for old in (XDG_DATA / "icons").glob(f"{APP}-papirus-*"):
        shutil.rmtree(old, ignore_errors=True)


def icons_apply(dirp, lines, decl_acc, mode):
    """Declared Yaru variant (else the one nearest the accent), -dark on dark themes; else Papirus with
    accent-colored folders; else leave the icon theme alone."""
    have = installed_icon_themes()
    c = scheme_from(lines, decl_acc, mode)
    want = ""
    f = dirp / "icons.theme" if dirp else None
    if f and f.exists():
        first = (f.read_text(errors="ignore").strip().splitlines() or [""])[0].strip()
        want = first if re.fullmatch(r"[A-Za-z0-9._-]{1,40}", first) else ""
    base = re.sub(r"-(dark|light)$", "", want)
    if any(n.startswith("Yaru") for n in have):
        pool = {k: v for k, v in YARU_VARIANTS.items() if k in have} or YARU_VARIANTS
        yaru = base if base in have else nearest_name(c["acc"], pool)
        for cand in ([f"{yaru}-dark"] if not c["light"] else []) + [yaru] + (["Yaru-dark"] if not c["light"] else ["Yaru"]):
            if cand in have:
                gset("org.gnome.desktop.interface", "icon-theme", cand)
                return cand
    if "Papirus" in have:
        name = papirus_overlay(c)
        if not name:
            name = "Papirus" if c["light"] else ("Papirus-Dark" if "Papirus-Dark" in have else "Papirus")
        gset("org.gnome.desktop.interface", "icon-theme", name)
        return name
    return None


def cursor_apply(light):
    have = installed_icon_themes()
    for cand in (("Bibata-Modern-Classic", "Bibata-Modern-Ice") if light else ("Bibata-Modern-Ice", "Bibata-Modern-Classic")):
        if cand in have:
            gset("org.gnome.desktop.interface", "cursor-theme", cand)
            return cand
    return None


def gtk3_theme_apply(light):
    want = "adw-gtk3" if light else "adw-gtk3-dark"
    if want in installed_gtk_themes():
        gset("org.gnome.desktop.interface", "gtk-theme", want)
        return want
    return None


def extension_states():
    """uuid → ACTIVE | INACTIVE | OUT OF DATE | ERROR | not loaded (GNOME only learns new dirs at login)"""
    out = {}
    for uuid, _ in EXTENSIONS:
        r = subprocess.run(["gnome-extensions", "info", uuid], capture_output=True, text=True)
        m = re.search(r"^\s*State:\s*(.+)$", r.stdout, re.M)
        out[uuid] = m.group(1).strip() if (r.returncode == 0 and m) else ("not loaded" if (EXT_DIR / uuid).exists() else "missing")
    return out


# ─────────────────────────────── generation: shell + gtk ─────────────────────
def _mix(a, b, t):
    ra, ga, ba = _rgb(a)
    rb, gb, bb = _rgb(b)
    return "#%02x%02x%02x" % (round(ra + (rb - ra) * t), round(ga + (gb - ga) * t), round(ba + (bb - ba) * t))


def _rgba(h, a):
    r, g, b = _rgb(h)
    return f"rgba({r},{g},{b},{a})"


def _lum(h):
    r, g, b = _rgb(h)
    return (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255


def scheme_from(lines, decl_acc, mode):
    pal, meta = palette_of(lines)
    bgc = meta.get("background") or "#000000"
    fgc = meta.get("foreground") or "#edeef1"
    light = (mode == "light") or (_lum(bgc) > 0.5)
    acc = decl_acc or pal.get(4) or fgc
    if _lum(acc) < 0.12 and not light:
        acc = fgc
    step = (lambda t: _mix(bgc, "#ffffff", t)) if not light else (lambda t: _mix(bgc, "#000000", t))
    return dict(bg=bgc, fg=fgc, acc=acc, light=light, surface=step(0.06), surface2=step(0.10),
                border=_rgba(fgc, 0.10), red=pal.get(1) or "#ff5f5f", green=pal.get(2) or "#5fd787",
                yellow=pal.get(3) or "#ffd75f", acc_fg=("#000000" if _lum(acc) > 0.6 else "#ffffff"))


SHELL_CSS = """@import url("resource:///org/gnome/shell/theme/gnome-shell.css");
/* theme: @NAME@ — GNOME Shell theme generated by @APP@ (@CREDIT@). The stock stylesheet stays authoritative
   for layout; only color, translucency and depth are overridden, so a rejected rule can never break the shell. */

/* top bar */
#panel { background-color: @PANEL@; color: @FG@; box-shadow: none; }
#panel .panel-button { color: @FG@; }
#panel .panel-button:hover, #panel .panel-button:active, #panel .panel-button:checked, #panel .panel-button:focus { background-color: @ACC22@; color: @FG@; box-shadow: none; }

/* glass surfaces: menus, quick settings, calendar, notifications, osd, dialogs, search, switchers */
.popup-menu-content, .quick-settings, .quick-toggle-menu, .calendar, .datemenu-displays-section, .datemenu-today-button, .notification-banner, .message, .message-list, .osd-window, .modal-dialog, .search-section-content, .switcher-list, .candidate-popup-content, .weather, .world-clocks-button, .events-button, .app-folder-dialog, .workspace-switcher { background-color: @POPUP@; color: @FG@; border: 1px solid @BORDER@; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.40); }
.popup-menu-item:hover, .popup-menu-item:focus, .popup-menu-item:active, .popup-menu-item:checked { background-color: @ACC24@; color: @FG@; }
