COMMANDS = [c for _, cs in GROUPS for c in cs]


def cmd_help(topic=None):
    W = width()
    if topic:
        topic = topic.lstrip("-")
        for name, desc, ex in COMMANDS:
            head = (name.split() or [""])[0].strip("<>")
            if head == topic or name.startswith(topic) or (topic in ("apply", "name") and name.startswith("<name>")):
                print()
                print(f" {B('theme ' + name)}")
                print(f" {rule()}")
                for line in textwrap.wrap(desc, W - 4):
                    print(f"   {line}")
                print()
                print(f"   {D('examples')}")
                for e in ex:
                    print(f"     {e}")
                print()
                credit()
                return
        sys.exit(f"no such command: {topic}   (theme help)")
    col = 40
    print()
    print(f" {B('theme')} {D('v' + VERSION)}   {D('Omarchy-grade theming for GNOME on Arch — and any GNOME distro')}")
    print(f" {D(CREDIT)}   {D('·')}   {D('one command themes the whole OS; the terminal stays on Graphite unless you opt in')}")
    print(f" {rule()}")
    print(f" {B('USAGE')}   theme [command] [args]")
    for title, cmds in GROUPS:
        print()
        print(f" {B(title)}")
        for name, desc, ex in cmds:
            label = ("theme " + name).strip()
            lines = textwrap.wrap(desc, W - col - 4) or [""]
            print(f"   {label:<{col}} {lines[0]}")
            for l in lines[1:]:
                print(f"   {'':<{col}} {D(l)}")
    print()
    print(f" {B('WHAT A SWITCH CHANGES')}")
    for k, v in (("wallpaper", "GNOME picture-uri (+dark, +lock screen), zoom-fit"),
                 ("gnome shell", "generated ~/.themes/theme-<name>/ via User Themes — top bar, overview canvas, app grid tiles/folders/dots, dash + dash-to-dock, quick settings, menus, dialogs, lock"),
                 ("gtk apps", "theme gtk.css, or a generated libadwaita color sheet → ~/.config/gtk-4.0 + gtk-3.0 · adw-gtk3 / adw-gtk3-dark by mode when installed"),
                 ("gnome", "accent color from the theme's accent · color-scheme dark/light from its mode · fallback desktop color"),
                 ("icons", "the declared Yaru variant (-dark on dark themes), else Papirus with folders recolored to the accent · Bibata cursor: Ice on dark, Classic on light"),
                 ("terminals", "Ghostty include · Alacritty import · Kitty include · foot include — open windows recolor instantly over OSC; ctrl+shift+, makes new Ghostty windows match"),
                 ("tmux", "status line in the palette (window tabs, prefix/zoom state, command, session, clock), borders, messages, copy mode, popups, menus — sourced live; your #(…) plugin hooks kept; theme tmux mine returns your own"),
                 ("nvim", "~/.config/colson-arch-theme/active-nvim.lua via the init.lua hook — declared colorscheme at VimEnter, canvas cleared to the terminal surface; every running Neovim re-themed over RPC"),
                 ("btop", "~/.config/btop/themes/<name>.theme + color_theme in btop.conf"),
                 ("browser", "Chromium / Chrome / Brave frame color from the theme — handed to the running browser, never launched"),
                 ("editors", "VS Code / Cursor / VSCodium workbench.colorTheme when the theme's extension is already installed; graphite restores yours")):
        print(f"   {D(k):<20} {v}")
    print()
    print(f" {B('DOCTRINE')}")
    for l in textwrap.wrap("Graphite (true-black monochrome) is the base; every Omarchy palette is opt-in. Colors are whitelist-extracted "
                           "(colors.toml → ghostty.conf → alacritty.toml → kitty.conf); no theme code is ever executed. Every hook is "
                           "idempotent and reversible.", W - 4):
        print(f"   {l}")
    print()
    print(f" {B('PATHS')}")
    print(f"   {D('library'):<20} {THEMES}")
    print(f"   {D('state'):<20} {STATE}")
    print(f"   {D('shell themes'):<20} {SHELL_THEMES}/theme-<name>/")
    print(f" {rule()}")
    print(f" {D('NO_COLOR=1 / non-TTY disables color · FORCE_COLOR=1 forces it · --dry-run prints what would change')}   {D('·')}   {D(REPO_URL)}")
    credit()
    print()


def cmd_about(as_json=False):
    ts = themes()
    off = sum(1 for p in ts.values() if is_official(p))
    walls = sum(len(backgrounds(d)) for d in ts.values())
    try:
        size = subprocess.run(["du", "-sh", str(THEMES)], capture_output=True, text=True).stdout.split()[0]
    except Exception:
        size = "?"
    if as_json:
        print(json.dumps(dict(app=APP, version=VERSION, author=AUTHOR, handle=HANDLE, repo=REPO_URL, themes=len(ts),
                              official=off, community=len(ts) - off, wallpapers=walls, library_size=size,
                              active=active_name(), library=str(THEMES), state=str(STATE)), indent=2))
        return
    print()
    print(f" {B(APP)} {D('v' + VERSION)}   {D(CREDIT)}   {D(REPO_URL)}")
    print(f" {rule()}")
    print(f"   {D('what'):<14} Omarchy-grade theming for GNOME on Arch — and any GNOME distro. Shell · GTK · icons · cursor · terminals · tmux · nvim · btop · browser · editors — live")
    print(f"   {D('library'):<14} {len(ts)} themes ({off} official, {len(ts) - off} community) · {walls} wallpapers · {size} on disk")
    print(f"   {D('active'):<14} {active_name()}")
    print(f"   {D('doctrine'):<14} Graphite true-black monochrome is the base; every palette is opt-in; nothing from a theme is ever executed")
    print(f"   {D('built with'):<14} Python 3 · zero dependencies beyond GNOME + git · fzf for pick")
    print(f"   {D('license'):<14} MIT · themes belong to their authors (theme credits)")
    print(f" {rule()}")
    print()


def cmd_completions(shell):
    shipped = SCRIPT.parent.parent / "completions" / f"theme.{shell}"   # the maintained script, when installed beside the binary
    if shell in ("zsh", "bash", "fish") and shipped.exists():
        return print(shipped.read_text(), end="")
    cmds = [(("theme " + n).split()[1] if n else "") for n, _, _ in COMMANDS]
    cmds = [c for c in cmds if c and not c.startswith("<")]
    if shell == "zsh":
        print(f"""#compdef theme
# {APP} zsh completion — {CREDIT}
_theme() {{
  local -a cmds themes
  cmds=({' '.join(cmds)})
  if (( CURRENT == 2 )); then
    themes=(${{(f)"$(theme list --plain 2>/dev/null | sed 's/^[a-z]*: //' | tr ',' '\\n' | sed 's/^ *//')"}})
    _describe 'command' cmds; _describe 'theme' themes
  elif [[ $words[2] == (preview|show|wall|remove) ]]; then
    themes=(${{(f)"$(theme list --plain 2>/dev/null | sed 's/^[a-z]*: //' | tr ',' '\\n' | sed 's/^ *//')"}})
    _describe 'theme' themes
  fi
}}
_theme "$@"
""")
    elif shell == "bash":
        print(f"""# {APP} bash completion — {CREDIT}
_theme() {{
  local cur="${{COMP_WORDS[COMP_CWORD]}}"
  local themes="$(theme list --plain 2>/dev/null | sed 's/^[a-z]*: //' | tr ',' ' ')"
  COMPREPLY=($(compgen -W "{' '.join(cmds)} $themes" -- "$cur"))
}}
complete -F _theme theme
""")
    elif shell == "fish":
        print(f"# {APP} fish completion — {CREDIT}")
        for c in cmds:
            print(f"complete -c theme -f -a {c}")
        print("complete -c theme -f -a '(theme list --plain 2>/dev/null | sed \"s/^[a-z]*: //\" | tr \",\" \"\\n\" | string trim)'")
    else:
        sys.exit("usage: theme completions <zsh|bash|fish>")


# ─────────────────────────────── dispatch ────────────────────────────────────
def main(argv):
    a = [x for x in argv if x not in ("--plain", "--json", "--dry-run")]
    as_json = "--json" in argv
    plain = "--plain" in argv
    if not a:
        return cmd_status()
    c = a[0]
    rest = a[1:]
    if c in ("-h", "--help", "help"):
        return cmd_help(rest[0] if rest else None)
    if c in ("-V", "--version", "version"):
        return print(f"{APP} {VERSION}")
    if c == "list":
        return cmd_list(plain=plain, as_json=as_json)
    if c == "pick":
        return cmd_pick()
    if c == "preview":
        return cmd_preview(rest[0] if rest else active_name())
    if c == "show":
        return cmd_show(rest[0] if rest else active_name())
    if c == "random":
        ns = list(themes())
        if not ns:
            sys.exit("library is empty — run: theme sync")
        return apply(random.choice(ns), "random")
    if c == "next":
        ns = list(themes())
        if not ns:
            sys.exit("library is empty — run: theme sync")
        cur = active_name()
        return apply(ns[(ns.index(cur) + 1) % len(ns)] if cur in ns else ns[0], "first")
    if c == "graphite":
        return apply("graphite")
    if c == "wall":
        return cmd_wall(rest[0] if rest else "random")
    if c == "next-wall":
        return cmd_next_wall()
    if c == "rotate":
        return cmd_rotate(rest[0] if rest else "30")
    if c == "schedule":
        return cmd_schedule(rest)
    if c == "forge":
        return cmd_forge(rest)
    if c == "sync":
        return cmd_sync(official_only="--official" in rest)
    if c == "add":
        return cmd_add(rest[0] if rest else "", rest[1] if len(rest) > 1 else None)
    if c == "update":
        return cmd_update()
    if c == "remove":
        return cmd_remove(rest[0] if rest else "")
    if c == "credits":
        return cmd_credits()
    if c == "install":
        return cmd_install(no_sync="--no-sync" in rest, no_extensions="--no-extensions" in rest)
    if c == "uninstall":
        return cmd_uninstall(purge="--purge" in rest)
    if c == "activate":
        return cmd_activate()
    if c == "extensions":
        return cmd_extensions(upstream="--upstream" in rest, plain=plain)
    if c in ("target", "targets"):
        return cmd_target(rest)
    if c == "icons":
        return cmd_icons()
    if c == "doctor":
        return cmd_doctor(verbose="-v" in rest, as_json=as_json)
    if c == "export":
        return cmd_export()
    if c == "import":
        return cmd_import(rest[0]) if rest else sys.exit("usage: theme import <file.json>")
    if c == "completions":
        return cmd_completions(rest[0] if rest else "")
    if c == "current":
        return print(json.dumps({"active": active_name()}) if as_json else active_name())
    if c == "about":
        return cmd_about(as_json=as_json)
    if c == "tmux":
        return cmd_tmux(rest)
    return apply(c, "random" if (rest and rest[0] == "random") else "first")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        sys.exit(130)
    except (FileNotFoundError, PermissionError, NotADirectoryError, OSError) as e:
        print(f"theme: {e}", file=sys.stderr)
        sys.exit(1)
